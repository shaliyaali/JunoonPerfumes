<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Orders | Junoon Perfumes</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .font-serif { font-family: 'Playfair Display', serif; }
    </style>
</head>
<body class="bg-[#fbfaf9]">
    <header class="bg-black text-white py-6 px-12 flex justify-between items-center sticky top-0 z-50">
        <a href="/" class="text-2xl font-serif font-bold tracking-widest text-[#d4af37]">JUNOON</a>
        <nav class="flex gap-8 text-[10px] uppercase tracking-[0.2em] font-bold">
            <a href="/" class="hover:text-[#d4af37]">Home</a>
            <a href="/profile" class="text-[#d4af37]">Profile</a>
        </nav>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-16">
        <div class="flex justify-between items-center mb-12">
            <h1 class="text-4xl font-serif font-bold">My Orders</h1>
            <form action="/profile/myorders" method="GET" class="relative">
                <input type="text" name="search" value="<%= search %>" placeholder="Search by Order ID..." class="pl-10 pr-4 py-2 border border-gray-200 rounded-full text-sm outline-none focus:ring-1 focus:ring-[#d4af37]">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">search</span>
            </form>
        </div>

        <div class="space-y-8">
            <% if (orders.length === 0) { %>
                <div class="text-center py-20 bg-white rounded-2xl border border-gray-100 shadow-sm">
                    <p class="text-gray-500">No orders found.</p>
                </div>
            <% } %>

            <% orders.forEach(order => { %>
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                    <div class="bg-gray-50 px-8 py-4 flex justify-between items-center border-b border-gray-100">
                        <div class="flex gap-10">
                            <div>
                                <p class="text-[10px] uppercase font-bold text-gray-400">Order ID</p>
                                <p class="text-sm font-bold">#<%= order.orderId %></p>
                            </div>
                            <div>
                                <p class="text-[10px] uppercase font-bold text-gray-400">Date</p>
                                <p class="text-sm"><%= new Date(order.orderDate).toLocaleDateString() %></p>
                            </div>
                            <div>
                                <p class="text-[10px] uppercase font-bold text-gray-400">Total</p>
                                <p class="text-sm font-bold text-[#d4af37]">₹<%= order.totalAmount.toLocaleString() %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <a href="/orders/download-invoice/<%= order.orderId %>" class="flex items-center gap-1 text-[10px] uppercase font-bold text-gray-400 hover:text-[#d4af37] transition-colors">
                                <span class="material-symbols-outlined text-lg">download</span> Invoice
                            </a>
                            <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest bg-amber-50 text-amber-600 border border-amber-100">
                                <%= order.status %>
                            </span>
                        </div>
                    </div>
                    
                    <div class="p-8 space-y-6">
                        <% order.items.forEach(item => { %>
                            <div class="flex items-center gap-6">
                                <img src="<%= item.productImage %>" class="w-16 h-20 object-contain rounded bg-gray-50 p-2">
                                <div class="flex-1">
                                    <h4 class="font-bold"><%= item.productName %></h4>
                                    <p class="text-xs text-gray-500"><%= item.variantSize %> × <%= item.quantity %></p>
                                    <p class="text-[10px] font-bold uppercase tracking-widest mt-1 text-gray-400">Status: <%= item.status %></p>
                                </div>
                                <div class="flex gap-3">
                                    <% if (item.status === 'Pending') { %>
                                        <button onclick="handleAction('cancel', '<%= order.orderId %>', '<%= item._id %>')" class="text-[10px] font-bold uppercase border border-red-100 text-red-500 px-4 py-2 rounded hover:bg-red-50 transition-colors">Cancel</button>
                                    <% } else if (item.status === 'Delivered') { %>
                                        <button onclick="handleAction('return', '<%= order.orderId %>', '<%= item._id %>')" class="text-[10px] font-bold uppercase border border-gray-200 px-4 py-2 rounded hover:bg-gray-50 transition-colors">Return</button>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        async function handleAction(type, orderId, itemId) {
            const isReturn = type === 'return';
            const { value: reason } = await Swal.fire({
                title: isReturn ? 'Return Request' : 'Cancel Item',
                input: 'textarea',
                inputLabel: 'Please provide a reason',
                inputPlaceholder: 'Enter your reason here...',
                inputAttributes: { 'aria-label': 'Type your reason here' },
                showCancelButton: true,
                inputValidator: (value) => {
                    if (isReturn && !value) return 'You need to write a reason for return!';
                }
            });

            if (reason !== undefined) {
                const url = isReturn ? '/orders/return-item' : '/orders/cancel-item';
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ orderId, itemId, reason })
                    });
                    const data = await response.json();
                    if (data.success) {
                        Swal.fire('Success', data.message, 'success').then(() => location.reload());
                    } else {
                        throw new Error(data.message);
                    }
                } catch (err) {
                    Swal.fire('Error', err.message, 'error');
                }
            }
        }
    </script>
</body>
</html>
