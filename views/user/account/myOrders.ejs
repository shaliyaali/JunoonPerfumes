<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Orders | Junoon Perfumes</title>
    <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&amp;family=Inter:wght@300;400;500;600&amp;family=Material+Symbols+Outlined&amp;display=swap"
    rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
    <script>
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              colors: {
                primary: "#D4AF37",
                "background-light": "#F9F9F7",
                "background-dark": "#0F0F0F",
                "card-light": "#FFFFFF",
                "card-dark": "#1A1A1A",
                "accent-gold": "#C5A028",
                "luxury-black": "#0a0a0a",
                "luxury-ivory": "#fbfaf9",
              },
              fontFamily: {
                display: ["Playfair Display", "serif"],
                sans: ["Inter", "sans-serif"],
              },
              borderRadius: { DEFAULT: "16px" },
            },
          },
        };
      </script>
    <style type="text/tailwindcss">
        body { font-family: 'Inter', sans-serif; }
        .font-display { font-family: 'Playfair Display', serif; }
        .sidebar-active {
          background: linear-gradient(90deg, rgba(212, 175, 55, 0.1) 0%, rgba(212, 175, 55, 0) 100%);
          border-left: 4px solid #D4AF37;
          color: #D4AF37;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark text-gray-800 dark:text-gray-100 transition-colors duration-300">
    <%- include('partials/_mainheader', { session, wishlistCount, cartCount, categories, search, activePage: 'myorders' }) %>

    <div class="flex flex-col md:flex-row min-h-screen">
        <%- include('partials/_sidebar', { user, activePage }) %>
        <main class="flex-grow p-6 md:p-12 space-y-8 max-w-5xl">
        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-12 gap-6">
            <h1 class="text-4xl font-serif font-bold">My Orders</h1>
            <form action="/profile/myorders" method="GET" class="flex flex-wrap items-center gap-3">
                <div class="relative">
                    <input type="text" name="search" value="<%= search %>" placeholder="Search ID or Product..." class="pl-10 pr-4 py-2 border border-gray-200 rounded-full text-xs outline-none focus:ring-1 focus:ring-[#d4af37] w-48">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">search</span>
                </div>
                <div class="flex items-center gap-2">
                    <input type="date" name="startDate" value="<%= startDate %>" class="px-3 py-2 border border-gray-200 rounded-lg text-[10px] uppercase font-bold outline-none focus:ring-1 focus:ring-[#d4af37]">
                    <span class="text-gray-400 text-xs font-bold uppercase">To</span>
                    <input type="date" name="endDate" value="<%= endDate %>" class="px-3 py-2 border border-gray-200 rounded-lg text-[10px] uppercase font-bold outline-none focus:ring-1 focus:ring-[#d4af37]">
                </div>
                <button type="submit" class="bg-black text-white px-4 py-2 rounded-lg text-[10px] uppercase font-bold tracking-widest hover:bg-[#d4af37] transition-colors">Filter</button>
                <a href="/profile/myorders" class="text-[10px] uppercase font-bold text-gray-400 hover:text-red-500 transition-colors">Clear</a>
            </form>
        </div>
       
        <div class="space-y-8">
            <% if (orders.length === 0) { %>
                <div class="text-center py-20 bg-white rounded-2xl border border-gray-100 shadow-sm">
                    <p class="text-gray-500">No orders found.</p>
                </div>
            <% } %>

            <% orders.forEach(order => { %>
                <% 
                    const orderDate = new Date(order.orderDate);
                    const isWithinLimit = (Date.now() - orderDate.getTime()) <= (7 * 24 * 60 * 60 * 1000);
                %>
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                    <div class="bg-gray-50 px-8 py-4 flex justify-between items-center border-b border-gray-100">
                        <div class="flex gap-10">
                            <div>
                                <p class="text-[10px] uppercase font-bold text-gray-400">Order ID</p>
                                <p class="text-sm font-bold">#<%= order.orderId %></p>
                            </div>
                            <div>
                                <p class="text-[10px] uppercase font-bold text-gray-400">Date</p>
                                <p class="text-sm"><%= new Date(order.orderDate).toLocaleDateString() %></p>
                            </div>
                            <div>
                                <p class="text-[10px] uppercase font-bold text-gray-400">Total</p>
                                <p class="text-sm font-bold text-[#d4af37]">₹<%= order.totalAmount.toLocaleString() %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <a href="/orders/download-invoice/<%= order.orderId %>" class="flex items-center gap-1 text-[10px] uppercase font-bold text-gray-400 hover:text-[#d4af37] transition-colors">
                                <span class="material-symbols-outlined text-lg">download</span> Invoice
                            </a>
                        </div>
                    </div>
                    
                    <div class="p-8 space-y-6">
                        <% order.items.forEach(item => { %>
                            <div class="flex items-center gap-6">
                                <img src="<%= item.productImage %>" class="w-16 h-20 object-contain rounded bg-gray-50 p-2">
                                <div class="flex-1">
                                    <h4 class="font-bold"><%= item.productName %></h4>
                                    <p class="text-xs text-gray-500"><%= item.variantSize %> × <%= item.quantity %></p>
                                    <p class="text-sm font-bold text-primary mt-1">₹<%= item.price.toLocaleString() %></p>
                                    <p class="text-[10px] font-bold uppercase tracking-widest mt-1 text-gray-400">Status: <%= item.status %></p>
                                </div>
                                <div class="flex gap-3">
                                    <% if (item.status === 'Pending' && isWithinLimit) { %>
                                        <button onclick="handleAction('cancel', '<%= order.orderId %>', '<%= item._id %>')" class="text-[10px] font-bold uppercase border border-red-100 text-red-500 px-4 py-2 rounded hover:bg-red-50 transition-colors">Cancel</button>
                                    <% } %>
                                    <% if (item.status === 'Delivered' && isWithinLimit) { %>
                                        <button onclick="handleAction('return', '<%= order.orderId %>', '<%= item._id %>')" class="text-[10px] font-bold uppercase border border-gray-200 px-4 py-2 rounded hover:bg-gray-50 transition-colors">Return</button>
                                    <% } %>
                                    <a href="/profile/myorders/<%= order.orderId %>/<%= item._id %>" class="text-[10px] flex items-center justify-center font-bold uppercase border border-gray-200 text-gray-600 px-4 py-2 rounded hover:bg-gray-50 transition-colors">Details</a>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- Pagination -->
        <div class="mt-12 flex justify-center">
            <% if (totalPages > 1) { %>
                <nav class="flex items-center space-x-2">
                    <% if (currentPage > 1) { %>
                        <a href="?page=<%= currentPage - 1 %>&search=<%= search %>&startDate=<%= startDate %>&endDate=<%= endDate %>" class="w-10 h-10 flex items-center justify-center rounded-lg border border-gray-200 hover:border-primary hover:text-primary transition-all text-gray-400">
                            <span class="material-symbols-outlined">chevron_left</span>
                        </a>
                    <% } %>
                    <span class="text-sm font-medium text-gray-600">Page <%= currentPage %> of <%= totalPages %></span>
                    <% if (currentPage < totalPages) { %>
                        <a href="?page=<%= currentPage + 1 %>&search=<%= search %>&startDate=<%= startDate %>&endDate=<%= endDate %>" class="w-10 h-10 flex items-center justify-center rounded-lg border border-gray-200 hover:border-primary hover:text-primary transition-all text-gray-400">
                            <span class="material-symbols-outlined">chevron_right</span>
                        </a>
                    <% } %>
                </nav>
            <% } %>
        </div>
    </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        async function handleAction(type, orderId, itemId) {
            const isReturn = type === 'return';

            const cancelReasons = {
                'Ordered by mistake': 'Ordered by mistake',
                'Changed my mind': 'Changed my mind',
                'Found better price elsewhere': 'Found better price elsewhere',
                'Incorrect size/variant selected': 'Incorrect size/variant selected',
                'Delivery is too slow': 'Delivery is too slow',
                'Other': 'Other'
            };

            const returnReasons = {
                'Damaged or leaking bottle': 'Damaged or leaking bottle',
                
                'Received wrong item': 'Received wrong item',
                'Defective packaging': 'Defective packaging',
                'Changed my mind': 'Changed my mind',
                'Other': 'Other'
            };

            const { value: reason } = await Swal.fire({
                title: isReturn ? 'Return Request' : 'Cancel Item',
                input: 'select',
                inputOptions: isReturn ? returnReasons : cancelReasons,
                inputLabel: 'Please select a reason',
                inputPlaceholder: 'Select a reason',
                showCancelButton: true,
                inputValidator: (value) => {
                    if (!value) return 'You need to select a reason!';
                }
            });

            if (reason) {
                const url = isReturn ? '/orders/return-item' : '/orders/cancel-item';
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ orderId, itemId, reason })
                    });
                    const data = await response.json();
                    if (data.success) {
                        Swal.fire('Success', data.message, 'success').then(() => location.reload());
                    } else {
                        throw new Error(data.message);
                    }
                } catch (err) {
                    Swal.fire('Error', err.message, 'error');
                }
            }
        }
    </script>
</body>
</html>
