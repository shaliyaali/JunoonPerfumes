<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title><%= product.name %> | Junoon Perfumes</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .font-serif { font-family: 'Playfair Display', serif; }
        .gold-gradient { background: linear-gradient(to bottom, #f9f295, #e0aa3e, #b8860b); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    </style>
</head>
<body class="bg-[#fbfaf9] text-[#121212]">
    <!-- Simple Luxury Header -->
    <header class="bg-black text-white py-6 px-12 flex justify-between items-center sticky top-0 z-50">
        <a href="/" class="text-2xl font-serif font-bold tracking-widest gold-gradient">JUNOON</a>
        <nav class="flex gap-8 text-[10px] uppercase tracking-[0.2em] font-bold">
            <a href="/" class="hover:text-[#d4af37]">Home</a>
            <a href="/allfragrence" class="text-[#d4af37]">All Fragrence</a>
           
        </nav>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-16">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
            <!-- Image Gallery -->
            <div class="space-y-4">
                <div class="aspect-[4/5] bg-white rounded-2xl border border-gray-100 overflow-hidden p-12 cursor-crosshair relative" id="mainImageContainer">
                    <img id="mainImage" src="<%= product.images[0] %>" alt="<%= product.name %>" class="w-full h-full object-contain transition-transform duration-200 ease-out pointer-events-none">
                </div>
                <div class="grid grid-cols-4 gap-4">
                    <% product.images.forEach((img, i) => { %>
                        <div class="aspect-square bg-white border border-gray-100 rounded-lg p-2 cursor-pointer hover:border-primary transition-all" onclick="document.getElementById('mainImage').src='<%= img %>'">
                            <img src="<%= img %>" class="w-full h-full object-contain">
                        </div>
                    <% }) %>
                </div>
            </div>

            <!-- Details -->
            <div class="flex flex-col">
                <nav class="text-[10px] uppercase tracking-widest text-gray-400 mb-4">
                    <a href="/allfragrence">All Fragrence</a> / <%= product.category.name %>/ <%= product.name %>
                </nav>
                <h1 class="text-5xl font-serif font-bold mb-2"><%= product.name %></h1>
                <p class="text-primary uppercase tracking-[0.3em] text-xs font-bold mb-6"><%= product.tagline %></p>
                
                <div class="flex items-center gap-4 mb-8">
                    <span id="displayPrice" class="text-3xl font-light">₹<%= product.variants[0].price.toLocaleString() %></span>
                    <% if(product.offer > 0) { %>
                        <span class="bg-primary/10 text-primary text-[10px] font-bold px-3 py-1 rounded-full"><%= product.offer %>% OFF</span>
                    <% } %>
                </div>

                <div class="mb-8 border-t border-b border-gray-100 py-8">
                    <div class="flex justify-between items-center">
                        <div>
                            <h3 class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-4">Select Size</h3>
                            <div class="flex gap-3">
                                <% product.variants.forEach((v, i) => { %>
                                    <button class="variant-btn px-6 py-3 border border-gray-200 rounded-xl text-xs font-bold hover:border-primary transition-all <%= i === 0 ? 'border-primary bg-primary/5 active-variant' : '' %>" 
                                            onclick="updateVariant(this, '<%= v.price %>', '<%= v.stock %>', '<%= v._id %>')">
                                        <%= v.size %>
                                    </button>
                                <% }) %>
                            </div>
                        </div>
                        <div class="text-right">
                            <h3 class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-4">Quantity</h3>
                            <div class="flex items-center border border-gray-200 rounded-xl overflow-hidden h-[46px]">
                                <button type="button" onclick="changeQty(-1)" class="px-4 py-2 hover:bg-gray-50 transition-colors">-</button>
                                <input type="number" id="purchaseQty" value="1" min="1" max="5" readonly class="w-12 text-center border-none focus:ring-0 font-bold text-sm bg-transparent">
                                <button type="button" onclick="changeQty(1)" class="px-4 py-2 hover:bg-gray-50 transition-colors">+</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="space-y-4 mb-12">
                    <div class="flex gap-4">
                        <button type="button" id="bagBtn" onclick="addToBag()" class="flex-1 bg-black text-white py-5 rounded-xl font-bold text-[11px] uppercase tracking-[0.2em] hover:bg-primary transition-all">Add to Shopping Bag</button>
                        <!-- <button class="w-16 border border-gray-200 rounded-xl flex items-center justify-center hover:text-primary transition-all">
                            <span class="material-symbols-outlined">favorite</span>
                        </button> -->
                    </div>
                    <p id="stockStatus" class="text-center text-[10px] font-bold uppercase tracking-widest <%= product.variants[0].stock > 0 ? 'text-green-500' : 'text-red-500' %>">
                        <%= product.variants[0].stock > 0 ? 'In Stock - Ready to Ship' : 'Out of Stock' %>
                    </p>
                </div>

                <div class="space-y-6">
                    <details class="group border-b border-gray-100 pb-4" open>
                        <summary class="flex justify-between items-center cursor-pointer list-none">
                            <span class="text-xs font-bold uppercase tracking-widest">Description</span>
                            <span class="material-symbols-outlined group-open:rotate-180 transition-transform">expand_more</span>
                        </summary>
                        <div class="mt-4 text-sm text-gray-500 leading-relaxed font-light">
                            <%= product.description %>
                        </div>
                    </details>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-sm">filter_vintage</span>
                        <span class="text-[10px] font-bold uppercase tracking-widest">Note: <%= product.note %></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Products -->
        <section class="mt-32">
            <h2 class="text-3xl font-serif font-bold mb-12">Related Products</h2>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <% relatedProducts.forEach(rp => { %>
                    <a href="/product/<%= rp._id %>" class="group">
                        <div class="aspect-square bg-white border border-gray-50 rounded-2xl p-8 mb-4 overflow-hidden relative">
                            <img src="<%= rp.images[0] %>" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-700">
                        </div>
                        <h4 class="text-sm font-bold uppercase tracking-widest text-center"><%= rp.name %></h4>
                        <p class="text-[10px] text-gray-400 text-center mt-1">₹<%= rp.variants[0].price.toLocaleString() %></p>
                    </a>
                <% }) %>
            </div>
        </section>
    </main>

    <script>
        let currentVariantId = '<%= product.variants[0]._id %>';
        let currentStock = <%= product.variants[0].stock %>;
        const purchaseQtyInput = document.getElementById('purchaseQty');

        function changeQty(amt) {
            const qtyInput = document.getElementById('purchaseQty');
            let current = parseInt(qtyInput.value);
            let next = current + amt;
            if (next >= 1 && next <= 5) {
                qtyInput.value = next;
                // Ensure quantity doesn't exceed available stock
                if (next > currentStock) {
                    qtyInput.value = currentStock;
                }
            }
        }

        function updateVariant(btn, price, stock, id) {
            currentVariantId = id;
            const stockStatus = document.getElementById('stockStatus');
            if (parseInt(stock) > 0) {
                stockStatus.innerText = 'In Stock - Ready to Ship';
                stockStatus.classList.remove('text-red-500');
                stockStatus.classList.add('text-green-500');
            } else {
                stockStatus.innerText = 'Out of Stock';
                stockStatus.classList.remove('text-green-500');
                stockStatus.classList.add('text-red-500');
            }
            currentStock = parseInt(stock); // Update currentStock for quantity checks
            document.getElementById('displayPrice').innerText = '₹' + parseInt(price).toLocaleString();
            
            // UI feedback for selection
            document.querySelectorAll('.variant-btn').forEach(b => b.classList.remove('border-primary', 'bg-primary/5', 'active-variant'));
            btn.classList.add('border-primary', 'bg-primary/5', 'active-variant');

            // Adjust purchase quantity if it exceeds new variant's stock
            if (parseInt(purchaseQtyInput.value) > currentStock) {
                purchaseQtyInput.value = currentStock > 0 ? 1 : 0; // Reset to 1 or 0 if out of stock
                if (currentStock === 0) {
                    document.getElementById('bagBtn').disabled = true; // Disable add to bag if variant is out of stock
                }
            }
        }

        async function addToBag() {
            const quantity = document.getElementById('purchaseQty').value;
            try {
                const response = await fetch('/cart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        productId: '<%= product._id %>', 
                        variantId: currentVariantId,
                        quantity: quantity
                    })
                });

                if (response.redirected) {
                    window.location.href = '/signin';
                    return;
                }

                const data = await response.json();
                if (data.success) {
                    Swal.fire({ 
                        icon: 'success', 
                        title: 'Added to Cart', 
                        showConfirmButton: false, 
                        toast: true, 
                        position: 'top-end', 
                        timer: 1500 
                    }).then(() => {
                        window.location.href = '/cart';
                    });
                } else {
                    Swal.fire({ icon: 'warning', title: 'Notice', text: data.message, confirmButtonColor: '#D4AF37' });
                }
            } catch (error) {
                console.error('Error:', error);
                window.location.href = '/signin';
            }
        }

        // Magnifying Glass Hover Effect
        const mainImageContainer = document.getElementById('mainImageContainer');
        const mainImage = document.getElementById('mainImage');

        mainImageContainer.addEventListener('mousemove', (e) => {
            const rect = mainImageContainer.getBoundingClientRect();
            
            // Calculate mouse position relative to container in percentage
            const x = ((e.clientX - rect.left) / rect.width) * 100;
            const y = ((e.clientY - rect.top) / rect.height) * 100;

            mainImage.style.transformOrigin = `${x}% ${y}%`;
            mainImage.style.transform = "scale(2.5)";
        });

        mainImageContainer.addEventListener('mouseleave', () => {
            mainImage.style.transform = "scale(1)";
            mainImage.style.transformOrigin = "center center";
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>
