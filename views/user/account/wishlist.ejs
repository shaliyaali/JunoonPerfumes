<!DOCTYPE html>
<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Junoon Perfumes | User Profile</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&amp;family=Inter:wght@300;400;500;600&amp;family=Material+Icons+Outlined&amp;display=swap"
    rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#D4AF37", // Classic Gold
            "background-light": "#F9F9F7",
            "background-dark": "#0F0F0F",
            "card-light": "#FFFFFF",
            "card-dark": "#1A1A1A",
            "accent-gold": "#C5A028",
          },
          fontFamily: {
            display: ["Playfair Display", "serif"],
            sans: ["Inter", "sans-serif"],
          },
          borderRadius: {
            DEFAULT: "16px",
          },
        },
      },
    };
  </script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }

    .font-display {
      font-family: 'Playfair Display', serif;
    }

    .sidebar-active {
      background: linear-gradient(90deg, rgba(212, 175, 55, 0.1) 0%, rgba(212, 175, 55, 0) 100%);
      border-left: 4px solid #D4AF37;
      color: #D4AF37;
    }
  </style>
</head>

<body
  class="bg-background-light dark:bg-background-dark text-gray-800 dark:text-gray-100 transition-colors duration-300">
  <header class="bg-black text-white py-4 px-6 md:px-12 flex items-center justify-between sticky top-0 z-50">
    <div class="flex items-center space-x-2">
      <div class="w-10 h-10 bg-primary flex items-center justify-center rounded-md">
        <span class="font-display text-2xl font-bold text-black">J</span>
      </div>
      <div>
        <h1 class="font-display text-xl tracking-widest font-bold">JUNOON</h1>
        <p class="text-[10px] tracking-[0.2em] uppercase opacity-70">Perfumes</p>
      </div>
    </div>
    <nav class="hidden md:flex space-x-8 text-xs font-semibold tracking-widest uppercase">
      <a class="hover:text-primary transition" href="/">Home</a>
      <a class="text-primary" href="#">Best Seller</a>
      <a class="hover:text-primary transition" href="/allfragrence">All Fragrance</a>
      <a class="hover:text-primary transition" href="#">Shop</a>
    </nav>
    <div class="flex items-center space-x-5">
      <span class="material-icons-outlined cursor-pointer hover:text-primary">search</span>
      <a href="/wishlist" class="relative">
        <span class="material-icons-outlined cursor-pointer text-primary">favorite</span>
        <span id="wishlist-count" class="absolute -top-2 -right-2 bg-primary text-black text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center <%= (typeof wishlistCount !== 'undefined' && wishlistCount > 0) ? '' : 'hidden' %>"><%= typeof wishlistCount !== 'undefined' ? wishlistCount : 0 %></span>
      </a>
      <div class="relative cursor-pointer">
        <a href="/cart">
          <span class="material-icons-outlined hover:text-primary">shopping_bag</span>
          <span id="cart-count" class="absolute -top-2 -right-2 bg-primary text-black text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center <%= (typeof cartCount !== 'undefined' && cartCount > 0) ? '' : 'hidden' %>"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
        </a>
      </div>
      <a href="/profile">
        <span class="material-icons-outlined cursor-pointer">person</span>
      </a>
    </div>
  </header>

  <div class="flex flex-col md:flex-row min-h-screen">
    <!-- <input type="text" id="message" value="<%= message %>" name="message" hidden> -->
    <input type="text" id="message" value="<%= typeof message !== 'undefined' ? message : '' %>" hidden>
    <aside
      class="w-full md:w-72 bg-card-light dark:bg-card-dark border-r border-gray-200 dark:border-gray-800 flex flex-col pt-8 pb-4">
      <div class="px-8 mb-10 text-center md:text-left">
        <div
          class="w-20 h-20 rounded-full bg-gradient-to-tr from-primary to-accent-gold mx-auto md:mx-0 flex items-center justify-center mb-4 shadow-lg">
          <!--<span class="text-white text-3xl font-display font-bold">S</span>!-->
          <span class="text-white text-3xl font-display font-bold">
            <%= user.name.charAt(0).toUpperCase() %>
          </span>

        </div>
        <h2 class="text-lg font-bold font-display">
          <%= user.name %>
        </h2>
        <span
          class="inline-block px-2 py-0.5 mt-1 bg-gray-100 dark:bg-gray-800 text-[10px] font-bold tracking-widest uppercase rounded text-gray-500 dark:text-gray-400">User</span>
      </div>
      <nav class="flex-grow space-y-1">
        <a class="flex items-center px-8 py-4 text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-800/50 transition" href="/profile">
          <span class="material-icons-outlined mr-3 text-gray-400">person</span>
          Profile Info
        </a>
        <a class="flex items-center px-8 py-4 text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-800/50 transition"
          href="#">
          <span class="material-icons-outlined mr-3 text-gray-400">confirmation_number</span>
          My Coupons
        </a>
        <a class="flex items-center px-8 py-4 text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-800/50 transition"
          href="#">
          <span class="material-icons-outlined mr-3 text-gray-400">star_outline</span>
          My Reviews And Rating
        </a>
        <a class="flex items-center px-8 py-4 text-sm font-medium sidebar-active"
          href="/wishlist">
          <span class="material-icons-outlined mr-3">favorite_border</span>
          My Wish List
        </a>
      </nav>
      <div class="mt-auto px-8 py-6 border-t border-gray-100 dark:border-gray-800">
        <a class="flex items-center text-sm font-medium text-red-500 hover:opacity-80 transition" href="/logout">
          <span class="material-icons-outlined mr-3">logout</span>
          Logout
        </a>
      </div>
    </aside>

    <main class="flex-grow p-6 md:p-12 space-y-8 max-w-5xl">
      <header class="mb-8">
        <h1 class="text-3xl font-display font-bold text-gray-900 dark:text-white">My Wishlist</h1>
        <p class="text-gray-500 dark:text-gray-400 mt-2">Manage your favorite fragrances and items you love.</p>
      </header>

      <% if (wishlistItems && wishlistItems.length > 0) { %>
        <div id="wishlist-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% wishlistItems.forEach(item => { %>
            <div id="item-<%= item.product._id %>" class="bg-card-light dark:bg-card-dark rounded-DEFAULT overflow-hidden shadow-sm border border-gray-100 dark:border-gray-800 group transition-all duration-500">
              <div class="relative aspect-square bg-gray-50 dark:bg-gray-900 flex items-center justify-center p-6">
                <a href="/product/<%=item.product._id%>">
                <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>" class="max-h-full object-contain group-hover:scale-105 transition-transform duration-500">
                </a>
                <button onclick="removeFromWishlist('<%= item.product._id %>', '<%= item.variantId %>')" class="absolute top-4 right-4 w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-md text-primary hover:text-red-500 transition-colors" title="Remove from Wishlist">
                  <span class="material-icons-outlined">favorite</span>
                </button>
              </div>
              <div class="p-6">
                <h3 class="font-display font-bold text-lg mb-1"><%= item.product.name %></h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4"><%= item.product.tagline %></p>
                
                <div class="flex items-center justify-between mt-auto">
                  <span class="font-bold text-primary">
                    <% const variant = item.product.variants.find(v => v._id.toString() === item.variantId.toString()) %>
                    ₹<%= variant ? variant.price.toLocaleString() : 'N/A' %>
                  </span>
                  <button onclick="wishlisToCart('<%= item.product._id %>', '<%= item.variantId %>')" class="text-[10px] font-bold uppercase tracking-widest py-2 px-4 bg-primary text-black rounded hover:bg-black hover:text-primary transition-colors">
                    Add To Bag
                  </button>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div id="empty-state">
          <section class="bg-card-light dark:bg-card-dark p-8 rounded-DEFAULT shadow-sm border border-gray-100 dark:border-gray-800">
            <div class="flex flex-col items-center justify-center py-20 text-center">
              <span class="material-icons-outlined text-gray-200 dark:text-gray-700 text-9xl mb-6">favorite_border</span>
              <h3 class="text-xl font-display font-bold mb-2">Your wishlist is currently empty</h3>
              <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-xs">Save the items you love to keep track of them here.</p>
              <a href="/allfragrence" class="px-8 py-3 bg-primary text-black font-bold text-sm rounded uppercase tracking-wider transition hover:opacity-90">
                Discover Scents
              </a>
            </div>
          </section>
        </div>
      <% } %>

      <!-- Template for the empty state used by AJAX when the last item is removed -->
      <div id="dynamic-empty-state" class="hidden">
        <section class="bg-card-light dark:bg-card-dark p-8 rounded-DEFAULT shadow-sm border border-gray-100 dark:border-gray-800">
          <div class="flex flex-col items-center justify-center py-20 text-center">
            <span class="material-icons-outlined text-gray-200 dark:text-gray-700 text-9xl mb-6">favorite_border</span>
            <h3 class="text-xl font-display font-bold mb-2">Your wishlist is currently empty</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-xs">Save the items you love to keep track of them here.</p>
            <a href="/allfragrence" class="px-8 py-3 bg-primary text-black font-bold text-sm rounded uppercase tracking-wider transition hover:opacity-90">
              Discover Scents
            </a>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script>
    async function removeFromWishlist(productId, variantId) {
      try {
        const response = await fetch('/wishlist/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, variantId })
        });

        const data = await response.json();
        if (data.success) {
            const wishBadge = document.getElementById('wishlist-count');
            if (wishBadge) {
                wishBadge.textContent = data.wishlistCount;
                if (data.wishlistCount === 0) wishBadge.classList.add('hidden');
            }

            if (!data.added) {
          const itemElement = document.getElementById(`item-${productId}`);
          if (itemElement) {
            itemElement.classList.add('opacity-0', 'scale-95');
            setTimeout(() => {
              itemElement.remove();
              const grid = document.getElementById('wishlist-grid');
              // If no items left in grid or count is 0
              if (data.wishlistCount === 0) {
                grid.classList.add('hidden');
                document.getElementById('dynamic-empty-state').classList.remove('hidden');
              }
            }, 500);
            Swal.fire({ icon: 'info', title: 'Removed from Wishlist', toast: true, position: 'top-end', showConfirmButton: false, timer: 3000 });
          }
        }
        }
      } catch (error) {
        console.error('Error removing from wishlist:', error);
      }
    }
  async function wishlisToCart(productId, variantId) {
    try {
      // 1. Call the specific 'move to cart' endpoint
      const response = await fetch('/wishlist/to-cart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId, variantId })
      });
      console.log('................');
      const data = await response.json();

      if (data.success) {
        const cartBadge = document.getElementById('cart-count');
        const wishBadge = document.getElementById('wishlist-count');
        
        if (cartBadge) { cartBadge.textContent = data.cartCount; cartBadge.classList.remove('hidden'); }
        if (wishBadge) { wishBadge.textContent = data.wishlistCount; if(data.wishlistCount === 0) wishBadge.classList.add('hidden'); }

        Swal.fire({
          icon: 'success',
          title:'Moved to Bag',
          text:data.message,
          toast:true,
          position:'top-end',
          showConfirmButton:false,
          timer:3000
        });

        // 3. Remove the item from the UI immediately
        const itemElement = document.getElementById(`item-${productId}`);
        if (itemElement) {
          itemElement.classList.add('opacity-0', 'scale-95');
          setTimeout(() => {
            itemElement.remove();
            if (data.wishlistCount === 0) {
              const grid = document.getElementById('wishlist-grid');
              grid.classList.add('hidden');
              document.getElementById('dynamic-empty-state').classList.remove('hidden');
            }
          }, 500);
        }
      } else {
        throw new Error(data.message || 'Failed to move item');
      }
    } catch (error) {
      console.error('Error adding to cart:', error);
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: error.message || 'Could not move item to bag'
      });
    }
  }
    const message = document.getElementById('message').value;
    if (message) { Swal.fire(message); }
  </script>
</body>
</html>