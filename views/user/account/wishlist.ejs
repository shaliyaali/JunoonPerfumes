<!DOCTYPE html>
<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Junoon Perfumes | User Profile</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&amp;family=Inter:wght@300;400;500;600&amp;family=Material+Symbols+Outlined&amp;display=swap"
    rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#D4AF37", // Classic Gold
            "background-light": "#F9F9F7",
            "background-dark": "#0F0F0F",
            "card-light": "#FFFFFF",
            "card-dark": "#1A1A1A",
            "accent-gold": "#C5A028",
            "luxury-black": "#0a0a0a",
            "luxury-ivory": "#fbfaf9",
          },
          fontFamily: {
            display: ["Playfair Display", "serif"],
            sans: ["Inter", "sans-serif"],
          },
          borderRadius: {
            DEFAULT: "16px",
          },
        },
      },
    };
  </script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }

    .font-display {
      font-family: 'Playfair Display', serif;
    }

    .sidebar-active {
      background: linear-gradient(90deg, rgba(212, 175, 55, 0.1) 0%, rgba(212, 175, 55, 0) 100%);
      border-left: 4px solid #D4AF37;
      color: #D4AF37;
    }
  </style>
</head>

<body
  class="bg-background-light dark:bg-background-dark text-gray-800 dark:text-gray-100 transition-colors duration-300">
  <%- include('partials/_mainheader', { session, wishlistCount, cartCount, categories, search, activePage: 'wishlist'}) %>

  <div class="flex flex-col md:flex-row min-h-screen">
    <input type="text" id="message" value="<%= typeof message !== 'undefined' ? message : '' %>" hidden>
    <%- include('partials/_sidebar', { user, activePage }) %>

    <main class="flex-grow p-6 md:p-12 space-y-8 max-w-5xl">
      <header class="mb-8">
        <h1 class="text-3xl font-display font-bold text-gray-900 dark:text-white">My Wishlist</h1>
        <p class="text-gray-500 dark:text-gray-400 mt-2">Manage your favorite fragrances and items you love.</p>
      </header>

      <% if (wishlistItems && wishlistItems.length > 0) { %>
        <div id="wishlist-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% wishlistItems.forEach(item => { %>
            <div id="item-<%= item.product._id %>" class="bg-card-light dark:bg-card-dark rounded-DEFAULT overflow-hidden shadow-sm border border-gray-100 dark:border-gray-800 group transition-all duration-500">
              <div class="relative aspect-square bg-gray-50 dark:bg-gray-900 flex items-center justify-center p-6">
                <a href="/product/<%=item.product._id%>">
                <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>" class="max-h-full object-contain group-hover:scale-105 transition-transform duration-500">
                </a>
                <button onclick="removeFromWishlist('<%= item.product._id %>', '<%= item.variantId %>')" class="absolute top-4 right-4 w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-md text-primary hover:text-red-500 transition-colors" title="Remove from Wishlist">
                  <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1">favorite</span>
                </button>
                <div class="absolute top-4 left-4">
                    <% if (item.maxOffer > 0) { %>
                        <span class="bg-primary text-white text-[10px] font-bold px-2 py-1 uppercase tracking-wider">
                            <%= item.maxOffer %>% OFF
                        </span>
                    <% } %>
                </div>
              </div>
              <div class="p-6">
                <h3 class="font-display font-bold text-lg mb-1"><%= item.product.name %></h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mb-4"><%= item.product.tagline %></p>
                
                <div class="flex items-end justify-between mt-auto">
                  <div class="flex flex-col">
                    <% if (item.displayVariant) { %>
                        <% if (item.displayVariant.salePrice < item.displayVariant.price) { %>
                            <span class="text-xs text-gray-400 line-through">₹<%= item.displayVariant.price.toLocaleString() %></span>
                            <span class="text-lg font-bold text-primary">₹<%= item.displayVariant.salePrice.toLocaleString() %></span>
                        <% } else { %>
                            <span class="text-lg font-bold text-primary">₹<%= item.displayVariant.price.toLocaleString() %></span>
                        <% } %>
                    <% } else { %>
                        <span class="text-lg font-bold text-primary">N/A</span>
                    <% } %>
                  </div>
                  <button type="button" onclick="VarientSelectionModal('<%= item.product._id %>')" class="text-[10px] font-bold uppercase tracking-widest py-2 px-4 bg-primary text-black rounded hover:bg-black hover:text-primary transition-colors">
                    Add To Cart
                  </button>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div id="empty-state">
          <section class="bg-card-light dark:bg-card-dark p-8 rounded-DEFAULT shadow-sm border border-gray-100 dark:border-gray-800">
            <div class="flex flex-col items-center justify-center py-20 text-center">
              <span class="material-symbols-outlined text-gray-200 dark:text-gray-700 text-9xl mb-6">favorite_border</span>
              <h3 class="text-xl font-display font-bold mb-2">Your wishlist is currently empty</h3>
              <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-xs">Save the items you love to keep track of them here.</p>
              <a href="/allfragrence" class="px-8 py-3 bg-primary text-black font-bold text-sm rounded uppercase tracking-wider transition hover:opacity-90">
                Discover Scents
              </a>
            </div>
          </section>
        </div>
      <% } %>

      <!-- Template for the empty state used by AJAX when the last item is removed -->
      <div id="dynamic-empty-state" class="hidden">
        <section class="bg-card-light dark:bg-card-dark p-8 rounded-DEFAULT shadow-sm border border-gray-100 dark:border-gray-800">
          <div class="flex flex-col items-center justify-center py-20 text-center">
            <span class="material-symbols-outlined text-gray-200 dark:text-gray-700 text-9xl mb-6">favorite_border</span>
            <h3 class="text-xl font-display font-bold mb-2">Your wishlist is currently empty</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-xs">Save the items you love to keep track of them here.</p>
            <a href="/allfragrence" class="px-8 py-3 bg-primary text-black font-bold text-sm rounded uppercase tracking-wider transition hover:opacity-90">
              Discover Scents
            </a>
          </div>
        </section>
      </div>
    </main>
  </div>

  <!-- Variant Selection Modal -->
  <div id="variant-selection-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
      <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden shadow-2xl transform transition-all">
          <div class="p-6 border-b border-gray-100 flex justify-between items-center">
              <h3 class="text-xl font-serif font-bold text-gray-900" id="modal-product-name">Select Size</h3>
              <button onclick="closeVariantModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                  <span class="material-symbols-outlined">close</span>
              </button>
          </div>
          <div class="p-8">
              <input type="hidden" id="modal-product-id">
              <div class="mb-8">
                  <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 mb-4">Available Sizes</label>
                  <div id="variant-options" class="grid grid-cols-2 gap-3">
                      <!-- Variants injected via JS -->
                  </div>
              </div>
              <div class="mb-8">
                  <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 mb-4">Quantity (Max 5)</label>
                  <div class="flex items-center border border-gray-200 w-32">
                      <button onclick="updateModalQty(-1)" class="w-10 h-10 flex items-center justify-center text-gray-500 hover:bg-gray-50">-</button>
                      <input type="number" id="modal-qty" value="1" min="1" max="5" readonly class="w-12 h-10 border-none text-center focus:ring-0 text-sm font-bold">
                      <button onclick="updateModalQty(1)" class="w-10 h-10 flex items-center justify-center text-gray-500 hover:bg-gray-50">+</button>
                  </div>
              </div>
              <button id="confirm-add-btn" class="w-full py-4 bg-primary text-black text-[10px] font-bold uppercase tracking-widest border border-primary hover:bg-black hover:text-primary transition-all duration-300">
                  Confirm Selection
              </button>
          </div>
      </div>
  </div>

  <script src="/js/cart.js"></script>
  <script>
    // Initialize the products data for the modal to use
    window.allProducts = [
        <% if (wishlistItems) { %>
            <%- wishlistItems.map(item => JSON.stringify(item.product)).join(',') %>
        <% } %>
    ];

    window.Junoon = {
        isAuthenticated: <%= (typeof session !== 'undefined' && session && session.user) ? 'true' : 'false' %>
    };

    async function removeFromWishlist(productId, variantId) {
      try {
        const response = await fetch('/wishlist/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, variantId })
        });

        const data = await response.json();
        if (data.success) {
            const wishBadge = document.getElementById('wishlist-count');
            if (wishBadge) {
                wishBadge.textContent = data.wishlistCount;
                if (data.wishlistCount === 0) wishBadge.classList.add('hidden');
            }

            if (!data.added) {
          const itemElement = document.getElementById(`item-${productId}`);
          if (itemElement) {
            itemElement.classList.add('opacity-0', 'scale-95');
            setTimeout(() => {
              itemElement.remove();
              const grid = document.getElementById('wishlist-grid');
              // If no items left in grid or count is 0
              if (data.wishlistCount === 0) {
                grid.classList.add('hidden');
                document.getElementById('dynamic-empty-state').classList.remove('hidden');
              }
            }, 500);
            Swal.fire({ icon: 'info', title: 'Removed from Wishlist', toast: true, position: 'top-end', showConfirmButton: false, timer: 3000 });
          }
        }
        }
      } catch (error) {
        console.error('Error removing from wishlist:', error);
      }
    }
  
   async function wishlisToCart(productId, variantId, quantity = 1) {
    try {
      const response = await fetch('/wishlist/to-cart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId, variantId, quantity })
      });
      const data = await response.json();

      if (data.success) {
        const cartBadge = document.getElementById('cart-count');
        const wishBadge = document.getElementById('wishlist-count');

        if (cartBadge) {
          cartBadge.textContent = data.cartCount;
          cartBadge.classList.remove('hidden');
        }
        if (wishBadge) {
          wishBadge.textContent = data.wishlistCount;
          if (data.wishlistCount === 0) wishBadge.classList.add('hidden');
        }

        Swal.fire({
          icon: 'success',
          title: 'Moved to Bag',
          text: data.message,
          toast: true,
          position: 'top-end',
          showConfirmButton: false,
          timer: 3000
        });

        // 3. Remove the item from the UI immediately
        const itemElement = document.getElementById(`item-${productId}`);
        if (itemElement) {
          itemElement.classList.add('opacity-0', 'scale-95');
          setTimeout(() => {
            itemElement.remove();
            if (data.wishlistCount === 0) {
              const grid = document.getElementById('wishlist-grid');
              if (grid) grid.classList.add('hidden');
              document.getElementById('dynamic-empty-state').classList.remove('hidden');
            }
          }, 500);
        }
      }
      else {
        throw new Error(data.message || 'Failed to move item');
      }
    } catch (error) {
      console.error('Error adding to cart:', error);
      Swal.fire({
        title: 'Error',
        text: error.message || 'Could not move item to bag'
      });
    }
  }
        
  
 

 function VarientSelectionModal(productId) {
        if (!window.Junoon.isAuthenticated) {
            Swal.fire({
                title: 'Sign In Required',
                text: "Please sign in to your account to add items to your shopping bag.",
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#d4af37',
                cancelButtonColor: '#1a1a1a',
                confirmButtonText: 'Go to Sign In',
                cancelButtonText: 'Maybe Later'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/signin`;
                }
            });
            return;
        }

        const product = window.allProducts.find(p => p._id === productId);
        if (!product) return;

        document.getElementById('modal-product-name').textContent = product.name;
        document.getElementById('modal-product-id').value = productId;
        document.getElementById('modal-qty').value = 1;

        const optionsContainer = document.getElementById('variant-options');
        optionsContainer.innerHTML = product.variants.map((v, index) => {
            const priceDisplay = `<p class="text-[10px] font-bold text-primary">₹${v.salePrice.toLocaleString()}</p>`;
            
            const stockDisplay = v.stock > 0 
                ? `<span class="text-[9px] text-gray-500 block">In Stock (${v.stock})</span>`
                : `<span class="text-[9px] text-red-500 block">Sold Out</span>`;

            return `
            <label class="relative cursor-pointer group">
                <input type="radio" name="variant-choice" value="${v._id}" class="peer hidden" ${index === 0 ? 'checked' : ''} data-stock="${v.stock}">
                <div class="border border-gray-200 p-3 text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-gray-900">${v.size}</p>
                    ${priceDisplay}
                    ${stockDisplay}
                </div>
            </label>
        `}).join('');

        const modal = document.getElementById('variant-selection-modal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeVariantModal() {
        const modal = document.getElementById('variant-selection-modal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    function updateModalQty(change) {
        const input = document.getElementById('modal-qty');
        let val = parseInt(input.value) + change;
        if (val < 1) val = 1;
        if (val > 5) val = 5;
        input.value = val;
    }

    document.getElementById('confirm-add-btn').addEventListener('click', () => {
        const productId = document.getElementById('modal-product-id').value;
        const variantRadio = document.querySelector('input[name="variant-choice"]:checked');
        const quantity = parseInt(document.getElementById('modal-qty').value);

        if (!variantRadio) return Swal.fire('Error', 'Please select a size', 'error');
        
        const stock = parseInt(variantRadio.dataset.stock);
        if (stock <= 0) return Swal.fire('Error', 'Selected size is out of stock', 'error');
        if (quantity > stock) return Swal.fire('Error', `Only ${stock} units available`, 'error');

        wishlisToCart(productId, variantRadio.value, quantity);
        closeVariantModal();
    });



    const message = document.getElementById('message').value;
    if (message) { Swal.fire(message); }
  </script>
</body>
</html>