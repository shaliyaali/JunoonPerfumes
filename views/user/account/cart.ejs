<!DOCTYPE html>
<html class="light" lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Junoon Perfumes | Shopping Bag</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&amp;family=Inter:wght@300;400;500;600&amp;family=Material+Symbols+Outlined&amp;display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#D4AF37",
            "background-light": "#F9F9F7",
            "background-dark": "#0F0F0F",
            "card-light": "#FFFFFF",
            "card-dark": "#1A1A1A",
            "luxury-black": "#0a0a0a",
            "luxury-ivory": "#fbfaf9",
          },
          fontFamily: {
            display: ["Playfair Display", "serif"],
            sans: ["Inter", "sans-serif"],
          },
          borderRadius: { DEFAULT: "16px" },
        },
      },
    };
  </script>
</head>
<body class="bg-background-light dark:bg-background-dark text-gray-800 dark:text-gray-100">

  <%- include('partials/_mainheader', { session, wishlistCount, cartCount, categories, search, activePage: 'cart' }) %>

  

  <div class="max-w-7xl mx-auto px-6 py-12">
    <h1 class="text-4xl font-display font-bold mb-12">Shopping Bag</h1>
    
    <div class="flex flex-col lg:flex-row gap-12">
      <div id="cart-items-container" class="lg:w-2/3 space-y-6">
        <% if (cart && cart.items && cart.items.length > 0) { %>
          <% cart.items.forEach(item => { %>
            <div id="cart-item-<%= item.variantId %>" class="bg-card-light dark:bg-card-dark p-6 rounded-DEFAULT shadow-sm border border-gray-100 dark:border-gray-800 flex flex-col sm:flex-row gap-6 items-center">
              <div class="w-24 h-32 bg-gray-50 rounded flex items-center justify-center p-4">
                <img src="<%= item.product ? item.product.images[0] : '' %>" alt="<%= item.product ? item.product.name : 'Product Unavailable' %>" class="max-h-full object-contain">
              </div>
              <div class="flex-grow text-center sm:text-left">
                <h3 class="font-display font-bold text-xl"><%= item.product ? item.product.name : 'Product Unavailable' %></h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mt-1">
                  <%= item.variantSize %>
                </p>
                <% if (item.status === 'out of stock') { %>
                <p class="text-red-500 text-xs mt-2">Out of stock</p>
                <% } else if (item.status === 'limitted') { %>
                <p class="text-yellow-500 text-xs mt-2">Only <%= item.stock %> left</p>
                <% } %>
                
                <div class="mt-4 flex items-center justify-center sm:justify-start gap-6">
                  <div class="flex items-center border border-gray-200 rounded-lg overflow-hidden bg-white">
                    <button id="minus-<%= item.variantId %>" 
                            onclick="updateQty('<%= item.product._id %>', '<%= item.variantId %>', -1)" 
                            class="px-3 py-1 hover:bg-gray-100 transition-colors <%= (item.quantity <= 1) ? 'opacity-50 cursor-not-allowed' : '' %>" 
                            >-</button>
                    <span id="qty-<%= item.variantId %>" class="px-4 py-1 text-sm font-bold border-x border-gray-200"><%= item.quantity %></span>
                    <button id="plus-<%= item.variantId %>" 
                            onclick="updateQty('<%= item.product._id %>', '<%= item.variantId %>', 1)" 
                            class="px-3 py-1 hover:bg-gray-100 transition-colors <%= (item.status === 'out of stock' || item.quantity >= 5 || item.quantity >= item.stock) ? 'opacity-50 cursor-not-allowed' : '' %>"
                            >+</button>
                  </div>
                  <button onclick="removeCartItem('<%= item.product._id %>', '<%= item.variantId %>')" class="text-[10px] font-bold text-red-500 uppercase tracking-[0.2em] hover:opacity-70 transition-opacity">Remove</button>
                </div>
              </div>
              <div class="text-right">
                <p id="total-<%= item.variantId %>" class="text-xl font-bold text-primary">₹<%= (item.price * item.quantity).toLocaleString() %></p>
                <p class="text-[10px] text-gray-400 mt-1 uppercase tracking-widest">₹<%= item.price.toLocaleString() %> each</p>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="bg-card-light dark:bg-card-dark p-8 rounded-DEFAULT shadow-sm border border-gray-100 dark:border-gray-800 flex flex-col items-center justify-center py-20 text-center">
            <span class="material-symbols-outlined text-gray-200 dark:text-gray-700 text-9xl mb-6">shopping_bag</span>
            <h3 class="text-xl font-display font-bold mb-2">Your bag is empty</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-xs">Looks like you haven't added any luxury scents to your bag yet.</p>
            <a href="/allfragrence" class="px-8 py-3 bg-primary text-black font-bold text-sm rounded uppercase tracking-wider transition hover:opacity-90">
              Start Shopping
            </a>
          </div>
        <% } %>
      </div>
      <% const hasInvalidItem = (cart && cart.items) ? cart.items.some(item => item.status === 'out of stock') : false; %>
      <div class="lg:w-1/3">
        <% 
          let subtotal = 0;
          if (cart && cart.items && cart.items.length > 0) {
            subtotal = cart.items.reduce((acc, item) => acc + (item.price * item.quantity), 0);
          }
        %>
        <div class="bg-card-light dark:bg-card-dark p-8 rounded-DEFAULT shadow-sm border border-gray-100 dark:border-gray-800 sticky top-32">
          <h3 class="text-xl font-display font-bold mb-6">Order Summary</h3>
          <div class="space-y-4 mb-8">
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Subtotal</span>
              <span id="summary-subtotal" class="font-medium">₹<%= subtotal.toLocaleString() %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Shipping</span>
              <span class="text-green-500 font-medium"></span>
            </div>
            <div class="border-t border-gray-100 dark:border-gray-800 pt-4 flex justify-between">
              <span class="font-bold uppercase tracking-widest text-xs">Total</span>
              <span id="summary-total" class="text-xl font-bold">₹<%= subtotal.toLocaleString() %></span>
            </div>
          </div>
          <button id="checkoutBtn" <%= (subtotal === 0 || hasInvalidItem)? 'disabled' : '' %> class="w-full py-4 <%=( subtotal === 0 || hasInvalidItem)? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-black text-white hover:bg-primary' %> font-bold rounded uppercase tracking-widest text-xs transition-all" type="button">
            Checkout
          </button>
          <div class="mt-6 flex items-center justify-center gap-4 text-gray-400">
            <!-- <span class="material-icons-outlined text-sm">lock</span> -->
            <!-- <span class="text-[10px] uppercase tracking-[0.2em] font-bold">Secure Checkout</span> -->
          </div>
        </div>
      </div>
      
    </div>
  </div>

  <!-- <footer class="mt-20 py-12 border-t border-gray-100 dark:border-gray-800 text-center">
    <div class="flex items-center justify-center space-x-2 mb-4">
      <div class="w-6 h-6 bg-primary flex items-center justify-center rounded">
        <span class="font-display text-sm font-bold text-black">J</span>
      </div>
      <h2 class="font-display text-lg tracking-widest font-bold">JUNOON</h2>
    </div>
    <p class="text-[10px] tracking-[0.4em] uppercase opacity-40">© 2024 Junoon Perfumes. All Rights Reserved.</p>
  </footer> -->

  <script>
    const message = "<%= typeof message !== 'undefined' ? message : '' %>";
    if (message) { Swal.fire(message); }

    // --- AJAX Search Logic ---
    const headerSearchForm = document.getElementById('header-search-form');
    const cartItemsContainer = document.getElementById('cart-items-container');

    if (headerSearchForm) {
        headerSearchForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const searchInput = headerSearchForm.querySelector('input[name="search"]');
            const searchValue = searchInput.value.trim();

            const params = new URLSearchParams({ ajax: 'true', search: searchValue });
            
            try {
                const response = await fetch(`/cart?${params.toString()}`);
                const data = await response.json();
                
                renderCartItems(data.cart);
                updateSummary(data.subtotal, data.hasInvalidItem);
                
                // Update header counts just in case
                const cartBadge = document.getElementById('cart-count');
                if (cartBadge) {
                    cartBadge.textContent = data.cartCount;
                    cartBadge.classList.toggle('hidden', data.cartCount === 0);
                }

                // Update URL state
                window.history.pushState({}, '', `/cart?search=${searchValue}`);
            } catch (error) {
                console.error('Error fetching filtered cart:', error);
            }
        });
    }

    function renderCartItems(cart) {
        if (!cart || !cart.items || cart.items.length === 0) {
            cartItemsContainer.innerHTML = `
                <div class="bg-card-light dark:bg-card-dark p-8 rounded-DEFAULT shadow-sm border border-gray-100 dark:border-gray-800 flex flex-col items-center justify-center py-20 text-center">
                    <span class="material-symbols-outlined text-gray-200 dark:text-gray-700 text-9xl mb-6">shopping_bag</span>
                    <h3 class="text-xl font-display font-bold mb-2">No items found</h3>
                    <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-xs">Adjust your search to find your fragrances.</p>
                </div>`;
            return;
        }

        cartItemsContainer.innerHTML = cart.items.map(item => `
            <div id="cart-item-${item.variantId}" class="bg-card-light dark:bg-card-dark p-6 rounded-DEFAULT shadow-sm border border-gray-100 dark:border-gray-800 flex flex-col sm:flex-row gap-6 items-center">
              <div class="w-24 h-32 bg-gray-50 rounded flex items-center justify-center p-4">
                <img src="${item.product ? item.product.images[0] : ''}" alt="${item.product ? item.product.name : 'Product Unavailable'}" class="max-h-full object-contain">
              </div>
              <div class="flex-grow text-center sm:text-left">
                <h3 class="font-display font-bold text-xl">${item.product ? item.product.name : 'Product Unavailable'}</h3>
                <p class="text-xs text-gray-500 uppercase tracking-widest mt-1">${item.variantSize}</p>
                ${item.status === 'out of stock' ? '<p class="text-red-500 text-xs mt-2">Out of stock</p>' : ''}
                ${item.status === 'limitted' ? `<p class="text-yellow-500 text-xs mt-2">Only ${item.stock} left</p>` : ''}
                <div class="mt-4 flex items-center justify-center sm:justify-start gap-6">
                  <div class="flex items-center border border-gray-200 rounded-lg overflow-hidden bg-white text-black">
                    <button onclick="updateQty('${item.product._id}', '${item.variantId}', -1)" class="px-3 py-1 hover:bg-gray-100 ${item.quantity <= 1 ? 'opacity-50 cursor-not-allowed' : ''}">-</button>
                    <span id="qty-${item.variantId}" class="px-4 py-1 text-sm font-bold border-x border-gray-200">${item.quantity}</span>
                    <button onclick="updateQty('${item.product._id}', '${item.variantId}', 1)" class="px-3 py-1 hover:bg-gray-100 ${item.status === 'out of stock' || item.quantity >= 5 || item.quantity >= item.stock ? 'opacity-50 cursor-not-allowed' : ''}">+</button>
                  </div>
                  <button onclick="removeCartItem('${item.product._id}', '${item.variantId}')" class="text-[10px] font-bold text-red-500 uppercase tracking-[0.2em] hover:opacity-70 transition-opacity">Remove</button>
                </div>
              </div>
              <div class="text-right">
                <p id="total-${item.variantId}" class="text-xl font-bold text-primary">₹${(item.price * item.quantity).toLocaleString()}</p>
                <p class="text-[10px] text-gray-400 mt-1 uppercase tracking-widest">₹${item.price.toLocaleString()} each</p>
              </div>
            </div>`).join('');
    }

    function updateSummary(subtotal, hasInvalidItem) {
        document.getElementById('summary-subtotal').innerText = '₹' + subtotal.toLocaleString();
        document.getElementById('summary-total').innerText = '₹' + subtotal.toLocaleString();
        const checkoutBtn = document.getElementById('checkoutBtn');
        const isDisabled = subtotal === 0 || hasInvalidItem;
        checkoutBtn.disabled = isDisabled;
        checkoutBtn.className = `w-full py-4 ${isDisabled ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-black text-white hover:bg-primary'} font-bold rounded uppercase tracking-widest text-xs transition-all`;
    }

    async function updateQty(productId, variantId, change) {
        try {
            const response = await fetch('/cart/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId, variantId, change })
            });
            const data = await response.json();
            if (data.success) {
                document.getElementById(`qty-${variantId}`).innerText = data.quantity;
                document.getElementById(`total-${variantId}`).innerText = '₹' + data.itemTotal.toLocaleString();
                document.getElementById('summary-subtotal').innerText = '₹' + data.subtotal.toLocaleString();
                document.getElementById('summary-total').innerText = '₹' + data.subtotal.toLocaleString();
                
                // Update button states dynamically
                const minusBtn = document.getElementById(`minus-${variantId}`);
                const plusBtn = document.getElementById(`plus-${variantId}`);

                if (minusBtn) {
                    data.quantity <= 1 
                        ? minusBtn.classList.add('opacity-50', 'cursor-not-allowed') 
                        : minusBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                }
                if (plusBtn) {
                    (data.quantity >= 5 || data.quantity >= data.stock)
                        ? plusBtn.classList.add('opacity-50', 'cursor-not-allowed')
                        : plusBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                }

                const cartBadge = document.getElementById('cart-count');
                if (cartBadge) {
                    cartBadge.textContent = data.cartCount;
                    cartBadge.classList.toggle('hidden', data.cartCount === 0);
                }
                
                // Show toast if the quantity was capped/adjusted by the server
                if (data.message && (data.message.includes('adjusted') || data.message.includes('Maximum'))) {
                    Swal.fire({ icon: 'info', title: 'Quantity Notice', text: data.message, toast: true, position: 'top-end', showConfirmButton: false, timer: 3000 });
                }
            } else {
                Swal.fire({ icon: 'warning', title: 'Limit Reached', text: data.message });
            }
        } catch (error) {
            console.error('Error updating quantity:', error);
        }
    }

    async function removeCartItem(productId, variantId) {
        const result = await Swal.fire({
            title: 'Remove item?',
            text: "This will remove the fragrance from your bag.",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#D4AF37',
            confirmButtonText: 'Yes, remove'
        });

        if (result.isConfirmed) {
            try {
                const response = await fetch('/cart/remove', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId, variantId })
                });
                const data = await response.json();
                if (data.success) {
                    const element = document.getElementById(`cart-item-${variantId}`);
                    element.classList.add('opacity-0', 'scale-95');
                    setTimeout(() => {
                        element.remove();
                        if (data.count === 0) {
                            window.location.reload(); // Show empty state
                        } else {
                            document.getElementById('summary-subtotal').innerText = '₹' + data.subtotal.toLocaleString();
                            document.getElementById('summary-total').innerText = '₹' + data.subtotal.toLocaleString();
                            const cartBadge = document.getElementById('cart-count');
                            if (cartBadge) {
                                cartBadge.textContent = data.count;
                                cartBadge.classList.toggle('hidden', data.count === 0);
                            }
                        }
                    }, 300);
                }
            } catch (error) {
                console.error('Error removing item:', error);
            }
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const checkoutBtn = document.getElementById('checkoutBtn');
        if (checkoutBtn) {
            checkoutBtn.addEventListener('click', () => {
                if (!checkoutBtn.disabled) {
                    window.location.href = '/checkout';
                }
            });
        }
    });
  </script>
</body>
</html>
