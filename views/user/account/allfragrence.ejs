

<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>All Fragrances | Junoon Perfumes</title>
<!-- Global Logic -->
<script src="/js/wishlist.js"></script>
<script src="/js/cart.js"></script>
<script src="/js/varientselection.js"></script>


<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&amp;family=Inter:wght@300;400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d4af37",



                                                "gold-metallic": "#c5a059",
                        "background-light": "#fbfaf9",
                        "background-dark": "#121212",
                        "luxury-black": "#0a0a0a",
                        "luxury-ivory": "#fbfaf9",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"],
                        "serif": ["Playfair Display", "serif"],
                    }
                },
            },
        }
    </script>
<style type="text/tailwindcss">
            
        :root {
            --primary-gold: #d4af37;
            --deep-black: #050505;
        }
        .gold-text-effect {
            background: linear-gradient(to bottom, #f9f295, #e0aa3e, #b8860b, #5d4a1f);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0px 1px 1px rgba(0,0,0,0.3);
        }
        
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        }
        .hero-gradient {
            background: linear-gradient(180deg, #0c0c0c 0%, #1a1a1a 100%);
        }
        .product-card-shadow:hover {
            box-shadow: 0 20px 40px -15px rgba(212, 175, 55, 0.1);
        }
        .bottle-mask-rect {
            clip-path: inset(10% 25% 10% 25% round 4px);
        }
        .bottle-mask-round {
            clip-path: circle(35% at 50% 60%);
        }
    </style>
</head>
<body class="bg-warm-ivory text-rich-black antialiased">

<%- include('partials/_mainheader', { session, wishlistCount, cartCount, categories, search, activePage: 'allfragrance' }) %>

<input type="hidden" id="success-message" value="<%= typeof message !== 'undefined' ? message : '' %>">
<section class="hero-gradient pt-20 pb-24 px-6 text-center relative overflow-hidden">
<div class="absolute inset-0 opacity-10 pointer-events-none">
<div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, rgba(212,175,55,0.15) 1px, transparent 0); background-size: 40px 40px;"></div>
</div>
<div class="max-w-[1550px] mx-auto relative z-10">
<span class="text-primary uppercase tracking-[0.5em] text-[10px] font-bold mb-6 block">The Complete Collection</span>
<h2 class="text-white text-5xl md:text-6xl font-display font-light tracking-tight mb-8">All Fragrances</h2>
<p class="text-gray-400 text-base md:text-lg font-light max-w-2xl mx-auto leading-relaxed italic">
            Explore our curated range of signature perfumes and rare attars, crafted for those who seek distinction.
        </p>
</div>
</section>
<main class="max-w-[1550px] mx-auto px-6 py-16 flex flex-col lg:flex-row gap-12">
<aside class="w-full lg:w-72 shrink-0">
<div class="sticky top-32 space-y-12">
<div>
<h3 class="text-[10px] font-bold uppercase tracking-[0.3em] text-primary mb-8 border-b border-primary/20 pb-2">Filter Excellence</h3>
 <div class="mb-10">
<p class="text-xs font-bold uppercase tracking-widest mb-5 flex items-center gap-2">
<span class="material-symbols-outlined text-sm">category</span>
        Categories
    </p>
<div id="category-filters" class="space-y-4">
    <% if(typeof categories !== 'undefined') { %>
        <% categories.forEach(cat => { %>
            <label class="flex items-center gap-3 cursor-pointer group">
                <input name="category" value="<%= cat._id %>" <%= (typeof category !== 'undefined' && category && category.split(',').filter(id => id.trim() !== '').includes(cat._id.toString())) ? 'checked' : '' %> class="w-4 h-4 border-gray-300 text-primary focus:ring-primary rounded-none category-checkbox" type="checkbox"/>
                <span class="text-sm text-gray-600 group-hover:text-primary transition-colors uppercase tracking-widest text-[11px]"><%= cat.name %></span>
            </label>
        <% }) %>
    <% } %>
</div>
</div> 
<div class="mb-10">
<p class="text-xs font-bold uppercase tracking-widest mb-5 flex items-center gap-2">
<span class="material-symbols-outlined text-sm">filter_vintage</span>
                        Fragrance Notes
                    </p>
<div class="space-y-6">
<label class="flex items-center gap-3 cursor-pointer group">
<input name="note" value="Floral" <%= (typeof note !== 'undefined' && note && note.split(',').includes('Floral')) ? 'checked' : '' %> class="w-4 h-4 border-gray-300 text-primary focus:ring-primary rounded-none" type="checkbox"/>
<span class="text-sm text-gray-600 group-hover:text-primary transition-colors uppercase tracking-widest text-[11px]">FLORAL</span>
</label>
<label class="flex items-center gap-3 cursor-pointer group">
<input name="note" value="Woody" <%= (typeof note !== 'undefined' && note && note.split(',').includes('Woody')) ? 'checked' : '' %> class="w-4 h-4 border-gray-300 text-primary focus:ring-primary rounded-none" type="checkbox"/>
<span class="text-sm text-gray-600 group-hover:text-primary transition-colors uppercase tracking-widest text-[11px]">WOODY</span>
</label>
<label class="flex items-center gap-3 cursor-pointer group">
<input name="note" value="Fresh" <%= (typeof note !== 'undefined' && note && note.split(',').includes('Fresh')) ? 'checked' : '' %> class="w-4 h-4 border-gray-300 text-primary focus:ring-primary rounded-none" type="checkbox"/>
<span class="text-sm text-gray-600 group-hover:text-primary transition-colors uppercase tracking-widest text-[11px]">FRESH</span>
</label>
<label class="flex items-center gap-3 cursor-pointer group">
<input name="note" value="oriental" <%= (typeof note !== 'undefined' && note && note.split(',').includes('oriental')) ? 'checked' : '' %> class="w-4 h-4 border-gray-300 text-primary focus:ring-primary rounded-none" type="checkbox"/>
<span class="text-sm text-gray-600 group-hover:text-primary transition-colors uppercase tracking-widest text-[11px]">ORIENTAL</span>
</label>
<label class="flex items-center gap-3 cursor-pointer group">
<input name="note" value="Musky" <%= (typeof note !== 'undefined' && note && note.split(',').includes('Musky')) ? 'checked' : '' %> class="w-4 h-4 border-gray-300 text-primary focus:ring-primary rounded-none" type="checkbox"/>
<span class="text-sm text-gray-600 group-hover:text-primary transition-colors uppercase tracking-widest text-[11px]">MUSKY</span>
</label>
<label class="flex items-center gap-3 cursor-pointer group">
<input name="note" value="Spicy" <%= (typeof note !== 'undefined' && note && note.split(',').includes('Spicy')) ? 'checked' : '' %> class="w-4 h-4 border-gray-300 text-primary focus:ring-primary rounded-none" type="checkbox"/>
<span class="text-sm text-gray-600 group-hover:text-primary transition-colors uppercase tracking-widest text-[11px]">SPICY</span>
</label>
</div>
</div>
<div class="mb-10">
<p class="text-xs font-bold uppercase tracking-widest mb-6 flex items-center gap-2">
<span class="material-symbols-outlined text-sm">payments</span>
                       
 Price
    </p>
<div class="space-y-4">
    <label class="flex items-center gap-3 cursor-pointer group">
        <input class="w-4 h-4 border-gray-300 text-primary focus:ring-primary rounded-none" type="radio" name="price" value="0-1000" <%= (typeof price !== 'undefined' && price === '0-1000') ? 'checked' : '' %>/>
        <span class="text-sm text-gray-600 group-hover:text-primary transition-colors uppercase tracking-widest text-[11px]">Below ₹1,000</span>
    </label>
    <label class="flex items-center gap-3 cursor-pointer group">
        <input class="w-4 h-4 border-gray-300 text-primary focus:ring-primary rounded-none" type="radio" name="price" value="1000-5000" <%= (typeof price !== 'undefined' && price === '1000-5000') ? 'checked' : '' %>/>
        <span class="text-sm text-gray-600 group-hover:text-primary transition-colors uppercase tracking-widest text-[11px]">₹1,000 - ₹5,000</span>
    </label>
    <label class="flex items-center gap-3 cursor-pointer group">
        <input class="w-4 h-4 border-gray-300 text-primary focus:ring-primary rounded-none" type="radio" name="price" value="5000-above" <%= (typeof price !== 'undefined' && price === '5000-above') ? 'checked' : '' %>/>
        <span class="text-sm text-gray-600 group-hover:text-primary transition-colors uppercase tracking-widest text-[11px]">Above ₹5,000</span>
    </label>
</div>
</div>
<button id="apply-filters" class="w-full py-4 bg-primary text-deep-black text-[10px] font-bold uppercase tracking-[0.2em] hover:bg-black hover:text-primary border border-primary transition-all duration-300">
                    Apply Filter
                </button>
<button id="clear-filters" class="w-full mt-4 py-2 text-gray-500 hover:text-primary text-[10px] font-bold uppercase tracking-[0.2em] transition-all duration-300 flex items-center justify-center gap-2">
     Clear All Filters
</button>
</div>
</div>
</aside>
<section class="flex-1">
<div class="flex flex-col sm:flex-row items-center justify-between mb-12 pb-6 border-b border-gray-200">
<p class="text-[10px] text-gray-400 font-bold uppercase tracking-[0.2em] mb-4 sm:mb-0">Displaying <span id="product-count" class="text-black text-xs"><%= typeof product !== 'undefined' ? product.length : 0 %></span> products</p>
<div class="flex items-center gap-6">
<span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Sort By</span>
<select id="sort-filter" class="bg-transparent border-none text-[10px] font-bold uppercase tracking-widest focus:ring-0 cursor-pointer text-black py-0">
<option value="newest" <%= sortValue === 'newest' ? 'selected' : '' %>>Collection Order</option>
<option value="price_desc" <%= sortValue === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
<option value="price_asc" <%= sortValue === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
</select>
</div>
</div>
<div id="product-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-10">
    <% if (typeof product !== 'undefined' && product.length > 0) { %>
        <% product.forEach(prod => { %>
            <div class="group flex flex-col bg-white border border-gray-100 product-card-shadow transition-all duration-500">
                <div class="aspect-[4/5] overflow-hidden relative bg-[#f4f3f1] flex items-center justify-center p-8">
                    <div class="relative w-full h-full cursor-pointer">
                        <a href="/product/<%= prod._id %>">
                            <img alt="<%= prod.name %>" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-1000" src="<%= prod.images && prod.images.length > 0 ? prod.images[0] : 'https://via.placeholder.com/400x500' %>"/>
                        </a>
                        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                            <span class="text-[10px] font-serif font-bold text-black/20 tracking-[0.3em] uppercase -rotate-90">Junoon</span>
                        </div>
                    </div>
                    <div class="absolute top-4 left-4 right-4 flex justify-between items-start">
                     <%
                        const pOffer=prod.offer || 0;
                        const cOffer=(prod.category && prod.category.offer) || 0; 
                        const currentMaxOffer=Math.max(pOffer,cOffer);
                    %>
                    <% if(currentMaxOffer > 0){ %>
                            <span class="bg-primary text-white text-[10px] font-bold px-2 py-1 uppercase tracking-wider">
                    <%= currentMaxOffer %>%OFF
                </span> 
                <% } else { %>
                <div>   </div>
                <% } %>
                           
                        
                        <% const isInWishlist = typeof wishlistIds !== 'undefined' && wishlistIds.includes(prod._id.toString()) %>
                        <button type="button" onclick="event.stopPropagation(); toggleWishlist('<%= prod._id %>', '<%= prod.variants[0]._id %>')" class="transition-colors wishlist-btn-<%= prod._id %> <%= isInWishlist ? 'text-primary' : 'text-gray-400' %>">
                            <span class="material-symbols-outlined" style="<%= isInWishlist ? "font-variation-settings: 'FILL' 1" : '' %>">favorite</span>
                        </button>
                    </div>
                </div>
                <div class="p-8 flex flex-col flex-1 text-center">
                    <p class="text-[9px] text-primary font-bold uppercase tracking-[0.3em] mb-3"><%= prod.category.name %></p>
                    <h4 class="text-xl font-serif font-medium text-gray-900 mb-2 tracking-wide"><%= prod.name %></h4>
                    <p class="text-[10px] text-gray-500 mb-6 font-medium uppercase tracking-widest italic"><%= prod.tagline %></p>
                    <div class="mt-auto space-y-4">
                        <div class="flex flex-col items-center">
                        <% if(prod.variants && prod.variants.length > 0) {
                            const cheapestVariant = prod.variants.reduce((prev, curr) => prev.salePrice < curr.salePrice ? prev : curr);
                        %>
                            <% if(cheapestVariant.salePrice < cheapestVariant.price){ %>
                                <span class="text-sm text-gray-400 line-through">₹<%= cheapestVariant.price.toLocaleString() %></span>
                                <span class="text-lg font-bold text-gray-900">₹<%= cheapestVariant.salePrice.toLocaleString() %></span>
                            <% } else { %>
                                <span class="text-lg font-bold text-gray-900">₹<%= cheapestVariant.price.toLocaleString() %></span>
                            <% } %>
                        <% } %>
                        </div>
                        <button type="button" onclick="VarientSelectionModal('<%= prod._id %>')" class="w-full py-4 bg-primary text-deep-black text-[10px] font-bold uppercase tracking-widest border border-primary hover:bg-deep-black hover:text-primary transition-all duration-300">
                            Add to Cart
                        </button> 
                    </div>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="col-span-full py-20 text-center">
            <p class="text-gray-500 uppercase tracking-widest text-sm">No fragrances found in this collection.</p>
        </div>
    <% } %>
</div>

<div id="pagination-container" class="border-t border-slate-100 dark:border-slate-800 p-6 flex items-center justify-center">
    <!-- Pagination will be rendered here via AJAX -->
    <%- include('partials/_pagination_dynamic', { totalPages, currentPage }) %>
</div>

</section>

</main>

<!-- Variant Selection Modal -->
<div id="variant-selection-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden shadow-2xl transform transition-all">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-xl font-serif font-bold text-gray-900" id="modal-product-name">Select Size</h3>
            <button onclick="closeVariantModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="p-8">
            <input type="hidden" id="modal-product-id">
            <div class="mb-8">
                <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 mb-4">Available Sizes</label>
                <div id="variant-options" class="grid grid-cols-2 gap-3">
                    <!-- Variants injected via JS -->
                </div>
            </div>
            <div class="mb-8">
                <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 mb-4">Quantity (Max 5)</label>
                <div class="flex items-center border border-gray-200 w-32">
                    <button onclick="updateModalQty(-1)" class="w-10 h-10 flex items-center justify-center text-gray-500 hover:bg-gray-50">-</button>
                    <input type="number" id="modal-qty" value="1" min="1" max="5" readonly class="w-12 h-10 border-none text-center focus:ring-0 text-sm font-bold">
                    <button onclick="updateModalQty(1)" class="w-10 h-10 flex items-center justify-center text-gray-500 hover:bg-gray-50">+</button>
                </div>
            </div>
            <button id="confirm-add-btn" class="w-full py-4 bg-primary text-deep-black text-[10px] font-bold uppercase tracking-widest border border-primary hover:bg-deep-black hover:text-primary transition-all duration-300">
                Confirm Selection
            </button>
        </div>
    </div>
</div>



<script>
    

    window.allProducts= <%- JSON.stringify(product || []) %>;
    window.Junoon={
        isAuthenticated: <%= (typeof session !== 'undefined' && session && session.user)? 'true' : 'false' %>

    }

    document.addEventListener('DOMContentLoaded', () => {
        // Existing DOMContentLoaded logic
        const applyBtn = document.getElementById('apply-filters');
        const clearBtn = document.getElementById('clear-filters');
        const productGrid = document.getElementById('product-grid');
        const productCount = document.getElementById('product-count');
        const sortFilter = document.getElementById('sort-filter');
        const searchInput = document.querySelector('input[name="search"]');
        const headerSearchForm = document.getElementById('header-search-form');

        function updateHeaderCounts(cart, wishlist) {
            const cartBadge = document.getElementById('cart-count');
            const wishBadge = document.getElementById('wishlist-count');
            const floatBadge = document.getElementById('floating-cart-count');

            if (cartBadge) { cartBadge.textContent = cart; cartBadge.classList.toggle('hidden', cart === 0); }
            if (floatBadge) { floatBadge.textContent = cart; }
            if (wishBadge) { wishBadge.textContent = wishlist; wishBadge.classList.toggle('hidden', wishlist === 0); }
        }

        async function updateProducts(page = 1) {
            // Get selected price
            const selectedPrice = document.querySelector('input[name="price"]:checked')?.value || '';
            const selectedSort = sortFilter.value;


            const searchValue = searchInput.value.trim();

            // Get selected categories from checkboxes
            const selectedCategories = Array.from(document.querySelectorAll('input[name="category"]:checked'))
                .map(cb => cb.value);

            // Get selected notes
            const selectedNotes = Array.from(document.querySelectorAll('input[name="note"]:checked'))
                .map(cb => cb.value);

            // Build query string
            const params = new URLSearchParams({
                ajax: 'true',
                search: searchValue,
                price: selectedPrice,
                sort: selectedSort,
                category: selectedCategories.join(','),
                note: selectedNotes.join(','),
                page: page
            });

            try {
                const response = await fetch(`/allfragrence?${params.toString()}`);
                const data = await response.json();
                
                window.allProducts = data.product;
                renderProducts(data.product, data.wishlistIds || []);
                renderPagination(data.totalPages, data.currentPage);
                productCount.textContent = data.product.length;
                updateHeaderCounts(data.cartCount, data.wishlistCount);
                
                // Cleanly update URL without refreshing
                const displayParams = new URLSearchParams(params);
                displayParams.delete('ajax');
                const newUrl = window.location.pathname + '?' + displayParams.toString();
                window.history.pushState({}, '', newUrl);

            } catch (error) {
                console.error('Error fetching products:', error);
            }
        }

        // Make function globally accessible for onclick events
        window.updateProducts = updateProducts;

        function renderProducts(products, wishlistIds = []) {
            if (!products || products.length === 0) {
                productGrid.innerHTML = `
                    <div class="col-span-full py-20 text-center">
                        <p class="text-gray-500 uppercase tracking-widest text-sm">No fragrances found in this collection.</p>
                    </div>`;
                return;
            }

            productGrid.innerHTML = products.map(prod => {
                const cheapestVariant= (prod.variants && prod.variants.length >0)?
                prod.variants.reduce((prev, curr) => prev.salePrice < curr.salePrice ? prev : curr) : null;

                const pOffer=prod.offer || 0;
                const cOffer=(prod.category && prod.category.offer) || 0; 
                const maxOffer=Math.max(pOffer,cOffer);
                const categoryName = prod.category ? prod.category.name : 'Perfume';
                const image = prod.images && prod.images.length > 0 ? prod.images[0] : 'https://via.placeholder.com/400x500';
                const isInWishlist=wishlistIds.includes(prod._id.toString());
                const btnColor = isInWishlist ? 'text-primary' : 'text-gray-400';
                const fillStyle = isInWishlist ? 'font-variation-settings: "FILL" 1' : '';

                // Safely get variant ID for wishlist
                const firstVariantId = (prod.variants && prod.variants.length > 0) ? prod.variants[0]._id : '';

                return `
                    <div class="group flex flex-col bg-white border border-gray-100 product-card-shadow transition-all duration-500">
                        <div class="aspect-[4/5] overflow-hidden relative bg-[#f4f3f1] flex items-center justify-center p-8">
                            <div class="relative w-full h-full cursor-pointer">
                                <a href="/product/${prod._id}">
                                    <img alt="${prod.name}" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-1000" src="${image}"/>
                                </a>
                                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                    <span class="text-[10px] font-serif font-bold text-black/20 tracking-[0.3em] uppercase -rotate-90">Junoon</span>
                                </div>
                            </div>
                            <div class="absolute top-4 left-4 right-4 flex justify-between items-start">
                               ${maxOffer > 0 ? `<span class="bg-primary text-white text-[10px] font-bold px-2 py-1 uppercase tracking-wider">${maxOffer}% OFF</span>` 

                                    : '<div></div>'}
                                <button type="button" onclick="event.stopPropagation(); toggleWishlist('${prod._id}', '${firstVariantId || ''}')" class="${btnColor} transition-colors wishlist-btn-${prod._id}">
                                    <span class="material-symbols-outlined" ${fillStyle}>favorite</span>
                                    </button>
                            </div>
                        </div>
                        <div class="p-8 flex flex-col flex-1 text-center">
                            <p class="text-[9px] text-primary font-bold uppercase tracking-[0.3em] mb-3">${categoryName}</p>
                            <h4 class="text-xl font-serif font-medium text-gray-900 mb-2 tracking-wide">${prod.name}</h4>
                            <p class="text-[10px] text-gray-500 mb-6 font-medium uppercase tracking-widest italic">${prod.tagline || ''}</p>
                            <div class="mt-auto space-y-4">
                             <div class="flex flex-col items-center">
                                ${cheapestVariant ?(cheapestVariant.salePrice < cheapestVariant.price ?`<span class="text-sm text-gray-400 line-through">₹${cheapestVariant.price.toLocaleString()}</span>
                                          <span class="text-lg font-bold text-gray-900">₹${cheapestVariant.salePrice.toLocaleString()}</span>`
                                       : `<span class="text-lg font-bold text-gray-900">₹${cheapestVariant.price.toLocaleString()}</span>`
                                   ) : '<span class="text-lg font-bold text-gray-900">Out of Stock</span>'}
                                </div>
                                <button type="button" onclick="VarientSelectionModal('${prod._id}')" class="w-full py-4 bg-primary text-deep-black text-[10px] font-bold uppercase tracking-widest border border-primary hover:bg-deep-black hover:text-primary transition-all duration-300">
                                    Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>`;
            }).join('');
        }

        function renderPagination(totalPages, currentPage) {
            const container = document.getElementById('pagination-container');
            if (totalPages <= 1) {
                container.innerHTML = '';
                return;
            }

            let html = '<nav class="flex items-center space-x-2">';
            
            if (currentPage > 1) {
                html += `
                    <button onclick="updateProducts(${currentPage - 1})" class="w-10 h-10 flex items-center justify-center rounded-lg border border-slate-200 hover:border-primary hover:text-primary transition-all text-slate-400">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </button>`;
            }

            html += '<div class="flex items-center space-x-2 px-4">';
            for (let i = 1; i <= totalPages; i++) {
                const isActive = currentPage === i;
                html += `
                    <button onclick="updateProducts(${i})" class="w-10 h-10 flex items-center justify-center rounded-lg font-medium text-sm transition-colors ${isActive ? 'bg-primary text-white font-bold shadow-lg shadow-primary/20' : 'hover:bg-slate-100 text-slate-500'}">
                        ${String(i).padStart(2, '0')}
                    </button>`;
            }
            html += '</div>';

            if (currentPage < totalPages) {
                html += `
                    <button onclick="updateProducts(${currentPage + 1})" class="w-10 h-10 flex items-center justify-center rounded-lg border border-slate-200 hover:border-primary hover:text-primary transition-all text-slate-400">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </button>`;
            }

            html += '</nav>';
            container.innerHTML = html;
        }

        applyBtn.addEventListener('click', (e) => {
            e.preventDefault();
            updateProducts();
        });

        clearBtn.addEventListener('click', (e) => {
            e.preventDefault();
            
            // Uncheck all category and note checkboxes
            document.querySelectorAll('input[name="category"], input[name="note"]').forEach(cb => cb.checked = false);
            // Uncheck all price radio buttons
            document.querySelectorAll('input[name="price"]').forEach(rb => rb.checked = false);
            // Reset sort filter to default
            sortFilter.value = 'newest';

            updateProducts();
        });

        // Make all inputs reactive for a "works together" feel
        sortFilter.addEventListener('change', () => updateProducts(1));
        document.querySelectorAll('input[name="category"], input[name="note"], input[name="price"]')
            .forEach(input => {
                input.addEventListener('change', () => updateProducts(1));
            });

        headerSearchForm.addEventListener('submit', (e) => {
            e.preventDefault();
            updateProducts();
        });

        // Initial pagination render if needed
        renderPagination(<%= totalPages %>, <%= currentPage %>);
    });

    

    document.getElementById('confirm-add-btn').addEventListener('click', () => {
        const productId = document.getElementById('modal-product-id').value;
        const variantRadio = document.querySelector('input[name="variant-choice"]:checked');
        const quantity = parseInt(document.getElementById('modal-qty').value);

        if (!variantRadio) return Swal.fire('Error', 'Please select a size', 'error');
        
        const stock = parseInt(variantRadio.dataset.stock);
        if (stock <= 0) return Swal.fire('Error', 'Selected size is out of stock', 'error');
        if (quantity > stock) return Swal.fire('Error', `Only ${stock} units available`, 'error');

        handleAddToCart(productId, variantRadio.value, quantity);
        closeVariantModal();
    });

   

     const msg = document.getElementById('success-message').value;
if (msg) {
    Swal.fire({
        icon: msg.includes('failed') || msg.includes('exists') ? 'error' : 'success',
        title: 'Notification',
        text: msg,
        timer: 2500,
        showConfirmButton: false,
        toast: true,
        position: 'top-end'
    });
}
</script>



</body></html>