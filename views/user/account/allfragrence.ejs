<script>
    

    window.allProducts= <%- JSON.stringify(product || []) %>;
    window.Junoon={
        isAuthenticated: <%= (typeof session !== 'undefined' && session && session.user)? 'true' : 'false' %>

    }

    document.addEventListener('DOMContentLoaded', () => {
        // Existing DOMContentLoaded logic
        const applyBtn = document.getElementById('apply-filters');
        const clearBtn = document.getElementById('clear-filters');
        const productGrid = document.getElementById('product-grid');
        const productCount = document.getElementById('product-count');
        const sortFilter = document.getElementById('sort-filter');
        const searchInput = document.querySelector('input[name="search"]');
        const headerSearchForm = document.getElementById('header-search-form');

        function updateHeaderCounts(cart, wishlist) {
            const cartBadge = document.getElementById('cart-count');
            const wishBadge = document.getElementById('wishlist-count');
            const floatBadge = document.getElementById('floating-cart-count');

            if (cartBadge) { cartBadge.textContent = cart; cartBadge.classList.toggle('hidden', cart === 0); }
            if (floatBadge) { floatBadge.textContent = cart; }
            if (wishBadge) { wishBadge.textContent = wishlist; wishBadge.classList.toggle('hidden', wishlist === 0); }
        }

        async function updateProducts() {
            // Get selected price
            const selectedPrice = document.querySelector('input[name="price"]:checked')?.value || '';
            const selectedSort = sortFilter.value;


            const searchValue = searchInput.value.trim();

            // Get selected categories from checkboxes
            const selectedCategories = Array.from(document.querySelectorAll('input[name="category"]:checked'))
                .map(cb => cb.value);

            // Get selected notes
            const selectedNotes = Array.from(document.querySelectorAll('input[name="note"]:checked'))
                .map(cb => cb.value);

            // Build query string
            const params = new URLSearchParams({
                ajax: 'true',
                search: searchValue,
                price: selectedPrice,
                sort: selectedSort,
                category: selectedCategories.join(','),
                note: selectedNotes.join(',')
            });

            try {
                const response = await fetch(`/allfragrence?${params.toString()}`);
                const data = await response.json();
                
                window.allProducts = data.product;
                renderProducts(data.product, data.wishlistIds || []);
                productCount.textContent = data.product.length;
                updateHeaderCounts(data.cartCount, data.wishlistCount);
                
                // Update URL without refreshing
                window.history.pushState({}, '', `/allfragrence?${params.toString().replace('&ajax=true', '')}`);
            } catch (error) {
                console.error('Error fetching products:', error);
            }
        }

        function renderProducts(products, wishlistIds = []) {
            if (!products || products.length === 0) {
                productGrid.innerHTML = `
                    <div class="col-span-full py-20 text-center">
                        <p class="text-gray-500 uppercase tracking-widest text-sm">No fragrances found in this collection.</p>
                    </div>`;
                return;
            }

            productGrid.innerHTML = products.map(prod => {
                const cheapestVariant= (prod.variants && prod.variants.length >0)?
                prod.variants.reduce((prev, curr) => prev.salePrice < curr.salePrice ? prev : curr) : null;

                const pOffer=prod.offer || 0;
                const cOffer=(prod.category && prod.category.offer) || 0; 
                const maxOffer=Math.max(pOffer,cOffer);
                const categoryName = prod.category ? prod.category.name : 'Perfume';
                const image = prod.images && prod.images.length > 0 ? prod.images[0] : 'https://via.placeholder.com/400x500';
                const isHidden = wishlistIds.includes(prod._id.toString()) ? 'hidden' : '';
                const isInWishlist=wishlistIds.includes(prod._id.toString());
                const btnColor = isInWishlist ? 'text-primary' : 'text-gray-400';
                const fillStyle = isInWishlist ? 'font-variation-settings: "FILL" 1' : '';
                

                return `
                    <div class="group flex flex-col bg-white border border-gray-100 product-card-shadow transition-all duration-500">
                        <div class="aspect-[4/5] overflow-hidden relative bg-[#f4f3f1] flex items-center justify-center p-8">
                            <div class="relative w-full h-full cursor-pointer">
                                <a href="/product/${prod._id}">
                                    <img alt="${prod.name}" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-1000" src="${image}"/>
                                </a>
                                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                    <span class="text-[10px] font-serif font-bold text-black/20 tracking-[0.3em] uppercase -rotate-90">Junoon</span>
                                </div>
                            </div>
                            <div class="absolute top-4 left-4 right-4 flex justify-between items-start">
                               ${maxOffer > 0 ? `<span class="bg-primary text-white text-[10px] font-bold px-2 py-1 uppercase tracking-wider">${maxOffer}% OFF</span>` 

                                    : '<div></div>'}
                                <button type="button" onclick="event.stopPropagation(); toggleWishlist('${prod._id}', '${prod.variants[0]._id}')" class="${btnColor} transition-colors wishlist-btn-${prod._id}">
                                    <span class="material-symbols-outlined" ${fillStyle}>favorite</span>
                                    </button>
                            </div>
                        </div>
                        <div class="p-8 flex flex-col flex-1 text-center">
                            <p class="text-[9px] text-primary font-bold uppercase tracking-[0.3em] mb-3">Junoon Perfumes</p>
                            <h4 class="text-xl font-serif font-medium text-gray-900 mb-2 tracking-wide">${prod.name}</h4>
                            <p class="text-[10px] text-gray-500 mb-6 font-medium uppercase tracking-widest italic">${prod.tagline || ''}</p>
                            <div class="mt-auto space-y-4">
                             <div class="flex flex-col items-center">
                                ${cheapestVariant ?(cheapestVariant.salePrice < cheapestVariant.price ?`<span class="text-sm text-gray-400 line-through">₹${cheapestVariant.price.toLocaleString()}</span>
                                          <span class="text-lg font-bold text-gray-900">₹${cheapestVariant.salePrice.toLocaleString()}</span>`
                                       : `<span class="text-lg font-bold text-gray-900">₹${cheapestVariant.price.toLocaleString()}</span>`
                                   ) : '<span class="text-lg font-bold text-gray-900">Out of Stock</span>'}
                                </div>
                                <button type="button" onclick="VarientSelectionModal('${prod._id}')" class="w-full py-4 bg-primary text-deep-black text-[10px] font-bold uppercase tracking-widest border border-primary hover:bg-deep-black hover:text-primary transition-all duration-300">
                                    Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>`;
            }).join('');
        }

        applyBtn.addEventListener('click', (e) => {
            e.preventDefault();
            updateProducts();
        });

        clearBtn.addEventListener('click', (e) => {
            e.preventDefault();
            
            // Uncheck all category and note checkboxes
            document.querySelectorAll('input[name="category"], input[name="note"]').forEach(cb => cb.checked = false);
            // Uncheck all price radio buttons
            document.querySelectorAll('input[name="price"]').forEach(rb => rb.checked = false);
            // Reset sort filter to default
            sortFilter.value = 'newest';

            updateProducts();
        });

        sortFilter.addEventListener('change', updateProducts);

        headerSearchForm.addEventListener('submit', (e) => {
            e.preventDefault();
            updateProducts();
        });
    });

    function VarientSelectionModal(productId) {
        if (!window.Junoon.isAuthenticated) {
            Swal.fire({
                title: 'Sign In Required',
                text: "Please sign in to your account to add items to your shopping bag.",
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#d4af37',
                cancelButtonColor: '#1a1a1a',
                confirmButtonText: 'Go to Sign In',
                cancelButtonText: 'Maybe Later'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/signin`;
                }
            });
            return;
        }

        const product = window.allProducts.find(p => p._id === productId);
        if (!product) return;

        document.getElementById('modal-product-name').textContent = product.name;
        document.getElementById('modal-product-id').value = productId;
        document.getElementById('modal-qty').value = 1;

        const optionsContainer = document.getElementById('variant-options');
        optionsContainer.innerHTML = product.variants.map((v, index) => {
            const priceDisplay = `<p class="text-[10px] font-bold text-primary">₹${v.salePrice.toLocaleString()}</p>`;
            
            const stockDisplay = v.stock > 0 
                ? `<span class="text-[9px] text-gray-500 block">In Stock (${v.stock})</span>`
                : `<span class="text-[9px] text-red-500 block">Sold Out</span>`;

            return `
            <label class="relative cursor-pointer group">
                <input type="radio" name="variant-choice" value="${v._id}" class="peer hidden" ${index === 0 ? 'checked' : ''} data-stock="${v.stock}">
                <div class="border border-gray-200 p-3 text-center peer-checked:border-primary peer-checked:bg-primary/5 transition-all">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-gray-900">${v.size}</p>
                    ${priceDisplay}
                    ${stockDisplay}
                </div>
            </label>
        `}).join('');

        const modal = document.getElementById('variant-selection-modal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeVariantModal() {
        const modal = document.getElementById('variant-selection-modal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    function updateModalQty(change) {
        const input = document.getElementById('modal-qty');
        let val = parseInt(input.value) + change;
        if (val < 1) val = 1;
        if (val > 5) val = 5;
        input.value = val;
    }

    document.getElementById('confirm-add-btn').addEventListener('click', () => {
        const productId = document.getElementById('modal-product-id').value;
        const variantRadio = document.querySelector('input[name="variant-choice"]:checked');
        const quantity = parseInt(document.getElementById('modal-qty').value);

        if (!variantRadio) return Swal.fire('Error', 'Please select a size', 'error');
        
        const stock = parseInt(variantRadio.dataset.stock);
        if (stock <= 0) return Swal.fire('Error', 'Selected size is out of stock', 'error');
        if (quantity > stock) return Swal.fire('Error', `Only ${stock} units available`, 'error');

        handleAddToCart(productId, variantRadio.value, quantity);
        closeVariantModal();
    });

