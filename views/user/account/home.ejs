<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Junoon Perfumes | Luxury Scent Collection</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#d4af37",
                        "luxury-black": "#0a0a0a",
                        "luxury-ivory": "#fbfaf9",
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        .font-serif { font-family: 'Playfair Display', serif; }
        body { font-family: 'Inter', sans-serif; }
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    </style>
</head>
<body class="bg-luxury-ivory text-luxury-black">
    
    <%- include('partials/_mainheader', { session, wishlistCount, cartCount, categories, search, activePage: 'home' }) %>

    <!-- Hero Banner -->
    <div class="relative bg-luxury-black py-20 text-center text-white">
        <div class="max-w-4xl mx-auto px-6">
            <h1 class="text-5xl font-serif font-bold mb-4">Junoon Perfumes</h1>
            <p class="text-xl text-gray-400 mb-8 italic">Find your signature scent among our exclusive collection.</p>
            <a href="/allfragrence" class="inline-block bg-primary text-black px-8 py-3 rounded-full font-bold uppercase tracking-widest hover:bg-white transition-all">
                Shop Collection
            </a>
        </div>
    </div>

    <!-- Featured Products Section -->
    <section class="max-w-7xl mx-auto px-6 py-24">
        <div class="flex flex-col md:flex-row justify-between items-end mb-16">
            <div>
                <span class="text-primary uppercase tracking-widest text-xs font-bold mb-2 block">Curated Selection</span>
                <h2 class="text-4xl font-serif font-bold">Featured Fragrances</h2>
            </div>
            <a href="/allfragrence" class="text-sm font-bold uppercase tracking-widest border-b-2 border-primary pb-1 hover:text-primary transition-colors mt-4 md:mt-0">
                View All
            </a>
        </div>




                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
            <% if (featuredProducts && featuredProducts.length > 0) { %>
                <% featuredProducts.forEach(product => { %>
                    <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 flex flex-col h-full border border-gray-100">
                        <!-- Image Area -->
                        <div class="relative aspect-[3/4] overflow-hidden bg-gray-50">
                            <img src="<%= product.images[0] %>" alt="<%= product.name %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">

                            <!-- Clickable Overlay for Product Details -->
                            <div class="absolute inset-0 cursor-pointer" onclick="window.location.href='/product/<%= product._id %>'">
                                <button class="absolute inset-x-0 bottom-0 p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-500 w-full bg-luxury-black text-white py-4 rounded-xl font-bold text-[10px] uppercase tracking-[0.2em] hover:bg-primary hover:text-black">
                                </button>
                            </div>
                        </div>

                        <!-- Info Area -->
                        <div class="p-6 flex flex-col flex-1">
                            <div class="flex justify-between items-start mb-2">
                                <span class="text-[10px] uppercase tracking-widest text-gray-400 font-bold"><%= product.category.name %></span>
                                <% if (product.variants[0].salePrice < product.variants[0].price) { %>
                                    <span class="bg-primary/10 text-primary text-[9px] font-bold px-2 py-0.5 rounded-full uppercase">Offer</span>
                                <% } %>
                            </div>
                            <h3 class="font-serif text-lg font-bold mb-2 cursor-pointer" onclick="window.location.href='/product/<%= product._id %>'">
                                <a class="hover:text-primary transition-colors">
                                    <%= product.name %> 
                                </a>
                            </h3>
                            <p class="text-gray-500 text-xs line-clamp-2 mb-6 italic leading-relaxed">
                                <%= product.tagline || 'Exquisite luxury fragrance crafted for perfection.' %>
                            </p>
                            
                            <div class="mt-auto flex items-center justify-between">
                                <div class="flex flex-col">
                                    <span class="text-lg font-bold text-luxury-black">₹<%= product.variants[0].salePrice.toLocaleString() %></span>
                                    <% if (product.variants[0].salePrice < product.variants[0].price) { %>
                                        <span class="text-xs text-gray-400 line-through">₹<%= product.variants[0].price.toLocaleString() %></span>
                                    <% } %>
                                </div>
                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest"><%= product.variants[0].size %></span>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-full py-20 text-center">
                    <p class="text-gray-400 italic">Our new collection is arriving soon. Please stay tuned.</p>
                </div>
            <% } %>
        </div>
    </section>

    <%- include('partials/_footer') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>