<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Dashboard | Junoon Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: { primary: "#D4AF37", "background-light": "#FAFAFA", "card-light": "#FFFFFF", "card-dark": "#242424" },
                    fontFamily: { display: ["Playfair Display", "serif"], sans: ["Inter", "sans-serif"] }
                },
            },
        };
    </script>
    <style type="text/tailwindcss">
        .luxury-shadow { box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05); }
    </style>
</head>
<body class="bg-background-light text-slate-900 transition-colors duration-200">
<div class="flex min-h-screen max-w-[1550px] mx-auto shadow-2xl">
    <%- include('partials/_sidebar', { activePage: 'dashboard' }) %>

    <main class="flex-1 flex flex-col bg-background-light">
        <header class="h-24 px-10 flex items-center justify-between border-b border-slate-200 bg-white">
            <h2 class="text-2xl font-bold text-slate-900">Dashboard Overview</h2>
            <!-- Filter Style from Reports -->
            <form id="dashboardFilter" action="/admin/dashboard" method="GET" class="flex gap-4">
                <div class="relative w-48">
                    <select name="reportFilter" onchange="this.form.submit()" class="w-full pl-4 pr-10 py-2.5 bg-white border border-slate-200 rounded-xl outline-none appearance-none text-xs font-bold uppercase tracking-widest">
                        <option value="today" <%= reportFilter === 'today' ? 'selected' : '' %>>Today</option>
                        <option value="this_week" <%= reportFilter === 'this_week' ? 'selected' : '' %>>This Week</option>
                        <option value="this_month" <%= reportFilter === 'this_month' ? 'selected' : '' %>>This Month</option>
                        <option value="this_year" <%= reportFilter === 'this_year' ? 'selected' : '' %>>This Year</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-sm">expand_more</span>
                </div>
            </form>
        </header>

        <div class="p-10 space-y-8 flex-1">
            <!-- Simple Top Boxes -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white p-6 rounded-2xl luxury-shadow border border-slate-100 flex items-center justify-between">
                    <div><p class="text-[10px] uppercase font-bold text-slate-400 tracking-widest mb-1">Total Orders</p><p class="text-3xl font-display font-bold text-slate-900"><%= totalOrders %></p></div>
                    <span class="material-symbols-outlined text-primary bg-primary/10 p-3 rounded-xl">shopping_bag</span>
                </div>
                <div class="bg-white p-6 rounded-2xl luxury-shadow border border-slate-100 flex items-center justify-between">
                    <div><p class="text-[10px] uppercase font-bold text-slate-400 tracking-widest mb-1">Total Users</p><p class="text-3xl font-display font-bold text-slate-900"><%= totalUsers %></p></div>
                    <span class="material-symbols-outlined text-emerald-500 bg-emerald-50 p-3 rounded-xl">group</span>
                </div>
                <div class="bg-white p-6 rounded-2xl luxury-shadow border border-slate-100 flex items-center justify-between">
                    <div><p class="text-[10px] uppercase font-bold text-slate-400 tracking-widest mb-1">Total Sales Revenue</p><p class="text-3xl font-display font-bold text-primary">₹<%= totalSalesAmount.toLocaleString() %></p></div>
                    <span class="material-symbols-outlined text-primary bg-primary/10 p-3 rounded-xl">payments</span>
                </div>
            </div>

            <!-- Graphs -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <div class="bg-white p-8 rounded-2xl luxury-shadow border border-slate-100">
                    <h3 class="font-display font-bold text-lg mb-6">Revenue Overview</h3>
                    <canvas id="revenueLineChart" height="200"></canvas>
                </div>
                <div class="bg-white p-8 rounded-2xl luxury-shadow border border-slate-100">
                    <h3 class="font-display font-bold text-lg mb-6">Order Status Summary</h3>
                    <canvas id="orderBarChart" height="200"></canvas>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Pie Chart -->
                <div class="bg-white p-8 rounded-2xl luxury-shadow border border-slate-100">
                    <h3 class="font-display font-bold text-lg mb-6">Top Categories</h3>
                    <canvas id="categoryPieChart"></canvas>
                </div>
                <!-- Top Selling Products -->
                <div class="lg:col-span-2 bg-white p-8 rounded-2xl luxury-shadow border border-slate-100">
                    <h3 class="font-display font-bold text-lg mb-6">Top 3 Selling Products</h3>
                    <div class="space-y-6">
                        <% topProducts.forEach((prod, index) => { %>
                            <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl hover:bg-slate-100 transition-colors">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 bg-white rounded-lg flex items-center justify-center font-display font-bold text-primary shadow-sm"><%= index + 1 %></div>
                                    <img src="<%= prod.image %>" class="w-12 h-12 object-cover rounded-lg border">
                                    <div><p class="font-bold text-sm"><%= prod.name %></p><p class="text-[10px] text-slate-400 uppercase tracking-widest"><%= prod.totalSold %> Units Sold</p></div>
                                </div>
                                <p class="font-bold text-primary">₹<%= prod.revenue.toLocaleString() %></p>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    // Revenue Line Chart
    const revenueCtx = document.getElementById('revenueLineChart').getContext('2d');
    new Chart(revenueCtx, {
        type: 'line',
        data: {
            labels: <%- JSON.stringify(revenueData.map(d => d._id)) %>,
            datasets: [{
                label: 'Revenue',
                data: <%- JSON.stringify(revenueData.map(d => d.total)) %>,
                borderColor: '#D4AF37',
                backgroundColor: 'rgba(212, 175, 55, 0.1)',
                fill: true,
                tension: 0.4
            }]
        },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });

    // Order Bar Chart
    const orderCtx = document.getElementById('orderBarChart').getContext('2d');
    new Chart(orderCtx, {
        type: 'bar',
        data: {
            labels: <%- JSON.stringify(orderSummaryData.map(d => d._id)) %>,
            datasets: [{
                label: 'Orders',
                data: <%- JSON.stringify(orderSummaryData.map(d => d.count)) %>,
                backgroundColor: ['#D4AF37', '#1e293b', '#64748b', '#94a3b8']
            }]
        },
        options: { plugins: { legend: { display: false } } }
    });

    // Category Pie Chart
    const pieCtx = document.getElementById('categoryPieChart').getContext('2d');
    new Chart(pieCtx, {
        type: 'doughnut',
        data: {
            labels: <%- JSON.stringify(topCategories.map(d => d._id)) %>,
            datasets: [{
                data: <%- JSON.stringify(topCategories.map(d => d.count)) %>,
                backgroundColor: ['#D4AF37', '#FDFBF7', '#1A1A1A', '#64748b', '#94a3b8']
            }]
        }
    });
</script>
</body>
</html>
