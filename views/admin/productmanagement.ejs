                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-secondary w-100">Filter</button>
                    </div>
                </form>
            </div> -->
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="w-full text-left">
                        <thead class="sticky top-0 z-10">
                            <tr class="border-b border-primary/20 bg-primary/[0.03] backdrop-blur-md">
                                <th class="px-8 py-5 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Name</th>
                                <th class="px-8 py-5 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Category</th>
                                <th class="px-8 py-5 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Variants</th>
                                <th class="px-8 py-5 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Price</th>
                                <th class="px-8 py-5 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Stock</th>
                                <th class="px-8 py-5 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Status</th>
                                <th class="px-8 py-5 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (product && product.length > 0) { %>
                                <% product.forEach(prod => { %>
                                    <tr class="hover:bg-slate-50 dark:hover:bg-white/[0.02] transition-colors group">
                                        <td class="px-8 py-5">
                                            <span class="font-bold text-slate-900 dark:text-white"><%= prod.name %></span>
                                        </td>
                                        <td class="px-8 py-5">
                                            <span class="text-slate-600 dark:text-slate-400"><%= prod.category ? prod.category.name : 'Uncategorized' %></span>
                                        </td>
                                        <td class="px-8 py-5">
                                            <span class="text-slate-600 dark:text-slate-400"><%= prod.variants ? prod.variants.length : 0 %></span>
                                        </td>

                                        <td class="px-8 py-5">
                                            <% if (prod.variants && prod.variants.length > 0) { %>
                                                <% 
                                                    const prices = prod.variants.map(v => v.price);
                                                    const minPrice = Math.min(...prices);
                                                    const maxPrice = Math.max(...prices);
                                                %>
                                                <span class="text-slate-900 dark:text-white font-medium">
                                                    <%= minPrice === maxPrice ? '₹' + minPrice : '₹' + minPrice + ' - ₹' + maxPrice %>
                                                </span>
                                            <% } else { %>
                                                <span class="text-muted">N/A</span>
                                            <% } %>
                                        </td>
                                        <td class="px-8 py-5">
                                            <% 
                                                const totalStock = prod.variants ? prod.variants.reduce((sum, v) => sum + v.stock, 0) : 0;
                                            %>
                                            <span class="font-semibold <%= totalStock === 0 ? 'text-red-500' : 'text-green-600 dark:text-green-400' %>">
                                                <%= totalStock %>
                                            </span>
                                        </td>
                                        <td class="px-8 py-5">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold <%= prod.status === 'Active' ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400' %>">
                                                <%= prod.status %>
                                            </span>
                                        </td>
                                        <td class="px-8 py-5 text-right">
                                            <div class="flex items-center justify-end space-x-6">
                                                <a href="/admin/editProduct/<%= prod._id %>" class="text-xs font-bold uppercase tracking-widest text-slate-400 hover:text-primary border-b border-transparent hover:border-primary transition-all">Edit</a>
                                                <button type="button" onclick="confirmDelete('<%= prod._id %>')" class="text-primary hover:text-red-500 transition-colors">
                                                    <span class="material-symbols-outlined text-xl">delete</span>
                                                </button>
                                                <form id="delete-form-<%= prod._id %>" action="/admin/deleteProduct/<%= prod._id %>" method="POST" class="hidden"></form>
                                            </div> 
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-box-open fa-2x mb-3"></i>
                                        <p>No products found matching your criteria.</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="border-t border-slate-100 dark:border-slate-800 p-6 flex items-center justify-center">
                    <% if (totalPages > 1) { %>
                        <nav class="flex items-center space-x-2">
                            <% if (currentPage > 1) { %>
                                <a href="?page=<%= currentPage - 1 %>&search=<%= search %>&status=<%= status %>" class="w-10 h-10 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 hover:border-primary hover:text-primary transition-all text-slate-400">
                                    <span class="material-symbols-outlined">chevron_left</span>
                                </a>
                            <% } %>
                            <div class="flex items-center space-x-2 px-4">
                                <% for(let i = 1; i <= totalPages; i++) { %>
                                    <a href="?page=<%= i %>&search=<%= search %>&status=<%= status %>" class="w-10 h-10 flex items-center justify-center rounded-lg font-medium text-sm transition-colors <%= currentPage == i ? 'bg-primary text-white font-bold shadow-lg shadow-primary/20' : 'hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400' %>">
                                        <%= i.toString().padStart(2, '0') %>
                                    </a>
                                <% } %>
                            </div>
                            <% if (currentPage < totalPages) { %>
                                <a href="?page=<%= currentPage + 1 %>&search=<%= search %>&status=<%= status %>" class="w-10 h-10 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 hover:border-primary hover:text-primary transition-all text-slate-400">
                                    <span class="material-symbols-outlined">chevron_right</span>
                                </a>
                            <% } %>
                        </nav>
                    <% } %>
                </div>
            </div>
        </div>
    </div>


</main>
</div>



    

 <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete(productId) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you really want to delete this product?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('delete-form-' + productId).submit();
                }
            })
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

</body></html>