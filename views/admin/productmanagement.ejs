<script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#D4AF37", // Gold
                        "background-light": "#FAFAFA",
                        "background-dark": "#0F0F0F",
                        "sidebar-light": "#FDFBF7",
                        "sidebar-dark": "#1A1A1A",
                        "card-light": "#FFFFFF",
                        "card-dark": "#242424",
                    },
                    fontFamily: {
                        display: ["Playfair Display", "serif"],
                        sans: ["Inter", "sans-serif"],
                    },
                    borderRadius: {
                        DEFAULT: "8px",
                    },
                },
