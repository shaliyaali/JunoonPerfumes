<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Junoon Category Management - Admin Suite</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,typography,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;family=Playfair+Display:wght@700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#D4AF37", // Gold
                        "background-light": "#FAFAFA",
                        "background-dark": "#0F0F0F",
                        "sidebar-light": "#FDFBF7",
                        "sidebar-dark": "#1A1A1A",
                        "card-light": "#FFFFFF",
                        "card-dark": "#242424",
                    },
                    fontFamily: {
                        display: ["Playfair Display", "serif"],
                        sans: ["Inter", "sans-serif"],
                    },
                    borderRadius: {
                        DEFAULT: "8px",
                    },
                },
            },
        };
    </script>
<style type="text/tailwindcss">
        @layer base {
            body {
                font-family: 'Inter', sans-serif;
            }
        }
        .luxury-shadow {
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 transition-colors duration-200">
<div class="flex min-h-screen max-w-[1550px] mx-auto shadow-2xl">

 <%- include('partials/_sidebar', { activePage: 'categories' }) %>
<input type="hidden" id="success-message" value="<%= typeof message !== 'undefined' ? message : '' %>">
<main class="flex-1 flex flex-col bg-background-light dark:bg-background-dark">
<header class="h-24 px-10 flex items-center justify-between border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-sidebar-dark">
<h2 class="text-2xl font-bold text-slate-900 dark:text-white">Category management</h2>
<div class="flex items-center space-x-4">
<button id="add-category-btn" class="bg-primary hover:bg-opacity-90 text-white px-6 py-2.5 rounded-lg flex items-center space-x-2 transition-all font-semibold shadow-md">
<span class="material-symbols-outlined text-sm">add</span>
<span>New Category</span>
</button>
<button class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 transition-colors" onclick="document.documentElement.classList.toggle('dark')">
<span class="material-symbols-outlined dark:hidden">dark_mode</span>
<span class="material-symbols-outlined hidden dark:block">light_mode</span>
</button>
</div>
</header>
<div class="p-10 space-y-8 flex-1 flex flex-col">
<!-- Search and Filter Form -->
<form action="/admin/categoryManagement" method="GET" class="flex flex-col md:flex-row gap-4">
    <div class="flex-1 relative">
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">search</span>
        <input name="search" class="w-full pl-12 pr-4 py-3 bg-white dark:bg-card-dark border border-slate-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none dark:text-slate-200" placeholder="Search Category..." type="text" value="<%= search %>"/>
    </div>
    <div class="w-full md:w-48 relative">
        <select name="status" class="w-full pl-4 pr-10 py-3 appearance-none bg-white dark:bg-card-dark border border-slate-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent outline-none dark:text-slate-200 cursor-pointer" onchange="this.form.submit()">
            <option value="all" <%= status === 'all' ? 'selected' : '' %>>All Status</option>
            <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
        <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">expand_more</span>
    </div>
    <button type="submit" class="w-full md:w-auto px-6 py-3 bg-primary text-white rounded-xl font-semibold hover:bg-opacity-90 transition-all">Search</button>
</form>

<div class="flex-1 flex flex-col">
<div class="bg-white dark:bg-card-dark border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden luxury-shadow flex-1 flex flex-col">
<div class="flex-1 overflow-auto">
<table class="w-full text-left">
<thead class="sticky top-0 z-10">
<tr class="border-b border-primary/20 bg-primary/[0.03] backdrop-blur-md">
<th class="px-8 py-5 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Name & Slug</th>
<th class="px-8 py-5 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Product Count</th>
<th class="px-8 py-5 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Offer</th>
<th class="px-8 py-5 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Status</th>
<th class="px-8 py-5 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 text-right">Actions</th>
</tr>
</thead>
<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
    <% if (category && category.length > 0) { %>
        <% category.forEach(cat => { %>
            <tr class="hover:bg-slate-50 dark:hover:bg-white/[0.02] transition-colors group">
                <td class="px-8 py-5">
                    <div class="font-bold text-slate-900 dark:text-white"><%= cat.name %></div>
                    <div class="text-xs text-slate-500 dark:text-slate-400 font-mono"><%= cat.slug %></div>
                </td>
                <td class="px-8 py-5">
                    <span class="text-slate-600 dark:text-slate-400"><%= cat.productCount %></span>
                </td>
                <td class="px-8 py-5">
                    <span class="text-slate-600 dark:text-slate-400"><%= cat.offer || 0 %>%</span>
                </td>
                <td class="px-8 py-5">
                    <% if (cat.status === 'Active') { %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400">
                            Active
                        </span>
                    <% } else { %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                            Inactive
                        </span>
                    <% } %>
                </td>
                <td class="px-8 py-5 text-right">
                    <div class="flex items-center justify-end space-x-6">
                        <button onclick="openEditModal('<%= cat._id %>', '<%= cat.name %>', '<%= cat.offer %>', '<%= cat.status %>')" type="button" class="text-xs font-bold uppercase tracking-widest text-slate-400 hover:text-primary border-b border-transparent hover:border-primary transition-all">Edit</button>
                        <button type="button" onclick="confirmDelete('<%= cat._id %>')" class="<%= cat.status === 'Active' ? 'text-primary hover:text-red-500' : 'text-slate-300 cursor-not-allowed' %> transition-colors" <%= cat.status === 'Inactive' ? 'disabled' : '' %>>
                            <span class="material-symbols-outlined text-xl">delete</span>
                        </button>
                        <form id="delete-form-<%= cat._id %>" action="/admin/deleteCategory/<%= cat._id %>" method="POST" class="hidden"></form>
                    </div>
                </td>
            </tr>
        <% }) %>
    <% } else { %>
        <tr>
            <td colspan="4" class="px-8 py-10 text-center text-slate-500 dark:text-slate-400">
                No categories found for your search criteria.
            </td>
        </tr>
    <% } %>
</tbody>
</table>
</div>
<div class="border-t border-slate-100 dark:border-slate-800 p-6 flex items-center justify-center">
    <% if (totalPages > 1) { %>
        <nav class="flex items-center space-x-2">
            <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>&search=<%= search %>&status=<%= status %>" class="w-10 h-10 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 hover:border-primary hover:text-primary transition-all text-slate-400">
                    <span class="material-symbols-outlined">chevron_left</span>
                </a>
            <% } %>
            <div class="flex items-center space-x-2 px-4">
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="?page=<%= i %>&search=<%= search %>&status=<%= status %>" class="w-10 h-10 flex items-center justify-center rounded-lg font-medium text-sm transition-colors <%= currentPage === i ? 'bg-primary text-white font-bold shadow-lg shadow-primary/20' : 'hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400' %>">
                        <%= i.toString().padStart(2, '0') %>
                    </a>
                <% } %>
            </div>
            <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>&search=<%= search %>&status=<%= status %>" class="w-10 h-10 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 hover:border-primary hover:text-primary transition-all text-slate-400">
                    <span class="material-symbols-outlined">chevron_right</span>
                </a>
            <% } %>
        </nav>
    <% } %>
</div>
</div>
</div>
</div>
</main>
</div>

<!-- Add Category Modal (Tailwind CSS) -->
<div id="add-category-modal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center p-4">
    <div class="bg-white dark:bg-card-dark rounded-2xl shadow-2xl p-8 w-full max-w-md m-auto">
        <div class="flex justify-between items-center mb-6">
            <h3 id="modal-title" class="text-xl font-bold text-slate-900 dark:text-white">Add New Category</h3>
            <button id="close-modal-btn" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form id="category-form" action="/admin/addCategory" method="POST" data-mode="add">
            <div class="space-y-4">
                <div>
                    <label for="categoryName" class="block text-sm font-medium text-slate-600 dark:text-slate-400 mb-2">Category Name</label>
                    <input type="text" id="categoryName" name="name"  class="w-full px-4 py-3 bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none dark:text-slate-200" placeholder="e.g., Perfumes">
                </div>
                <div>
                    <label for="offer" class="block text-sm font-medium text-slate-600 dark:text-slate-400 mb-2">Offer in Percentage(if any)</label>
                    <input type="number" id="offer" name="offer" min="0" max="100" class="w-full px-4 py-3 bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none dark:text-slate-200" placeholder="0">
                </div>
                <div>
                    <label for="categoryStatus" class="block text-sm font-medium text-slate-600 dark:text-slate-400 mb-2">Status</label>
                    <select id="categoryStatus" name="status" class="w-full px-4 py-3 bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent outline-none dark:text-slate-200 cursor-pointer">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="mt-8 flex justify-end space-x-4">
                <button type="button" id="cancel-modal-btn" class="px-6 py-2.5 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-semibold hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    Cancel
                </button>
                <button type="submit" id="modal-submit-btn" class="bg-primary hover:bg-opacity-90 text-white px-6 py-2.5 rounded-lg font-semibold shadow-md transition-all">
                    Save Category
                </button>
            </div>
        </form>
    </div>
</div>

 <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
 <script>
    const addCategoryModal = document.getElementById('add-category-modal');
    const addCategoryBtn = document.getElementById('add-category-btn');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const cancelModalBtn = document.getElementById('cancel-modal-btn');
    const categoryForm = document.getElementById('category-form');
    const modalTitle = document.getElementById('modal-title');
    const modalSubmitBtn = document.getElementById('modal-submit-btn');
    const nameInput = document.getElementById('categoryName');
    const offerInput = document.getElementById('offer');
    // Ensure statusInput is correctly defined if not already
    // const statusInput = document.getElementById('categoryStatus'); 
    const statusInput = document.getElementById('categoryStatus');

    const openAddModal = () => {
        categoryForm.reset();
        categoryForm.action = "/admin/addCategory";
        modalTitle.innerText = "Add New Category";
        modalSubmitBtn.innerText = "Save Category";
        categoryForm.dataset.mode = 'add'; // Set mode to add
        delete categoryForm.dataset.categoryId; // Clear categoryId for add mode
        addCategoryModal.classList.replace('hidden', 'flex');
    };

    const closeModal = () => addCategoryModal.classList.replace('flex', 'hidden');

    // Global function to be called from the Edit button in the table
    window.openEditModal = (id, name, offer, status) => {
        nameInput.value = name;
        offerInput.value = offer || 0;
        statusInput.value = status || 'Active';
        categoryForm.action = `/admin/editCategory/${id}`; // Ensure this route exists in your backend
        categoryForm.dataset.mode = 'edit'; // Set mode to edit
        categoryForm.dataset.categoryId = id; // Store the ID
        modalTitle.innerText = "Edit Category";
        modalSubmitBtn.innerText = "Update Category";
        addCategoryModal.classList.replace('hidden', 'flex');
    };

    window.confirmDelete = (categoryId) => {
        Swal.fire({
            title: 'Are you sure?',
            text: "Do you really want to delete this category?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!',
            
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('delete-form-' + categoryId).submit();
            }
        })
    };

    addCategoryBtn.addEventListener('click', openAddModal);
    closeModalBtn.addEventListener('click', closeModal);
    cancelModalBtn.addEventListener('click', closeModal);
    
    // Close modal if clicking outside of it
    addCategoryModal.addEventListener('click', (event) => {
        if (event.target === addCategoryModal) {
            closeModal();
        }
    });

    categoryForm.addEventListener('submit', async (e) => {
        // Basic validation for category name
        const nameVal = nameInput.value.trim();
        
        if (!nameVal || nameVal.length < 3) {
            e.preventDefault();
            closeModal();
            Swal.fire({
                icon: 'error',
                title: 'Validation Error',
                text: !nameVal ? 'Category name cannot be empty.' : 'Category name must be at least 3 characters long.',
                confirmButtonColor: '#D4AF37'
            });
            return; // Stop further execution
        }

        // If in edit mode, prevent default form submission and use fetch
        if (categoryForm.dataset.mode === 'edit') {
            e.preventDefault();
            const categoryId = categoryForm.dataset.categoryId;
            const url = `/admin/editCategory/${categoryId}`;

            const formData = {
                name: nameInput.value,
                offer: offerInput.value,
                status: statusInput.value
            };

            try {
                const response = await fetch(url, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire({ icon: 'success', title: 'Category Updated!', text: data.message || 'Category updated successfully.', timer: 2500, showConfirmButton: false, toast: true, position: 'top-end' }).then(() => {
                        window.location.reload(); // Reload to reflect changes
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Update Failed', text: data.message || 'Failed to update category.', confirmButtonColor: '#D4AF37' });
                }
            } catch (error) {
                console.error('Error updating category:', error);
                Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.', confirmButtonColor: '#D4AF37' });
            }
        }
    });

    // Handle Backend Errors via Flash Messages
    const backendError = "<%= error_msg %>";
    if (backendError && backendError.length > 0) {
        Swal.fire({
            icon: 'error',
            title: 'Action Failed',
            text: backendError,
            confirmButtonColor: '#D4AF37'
        });
    }

    const msg = document.getElementById('success-message').value;
if (msg) {
    Swal.fire({
        icon: msg.includes('failed') || msg.includes('exists') ? 'error' : 'success',
        title: 'Notification',
        text: msg,
        timer: 2500,
        showConfirmButton: false,
        toast: true,
        position: 'top-end'
    });
}
</script>
</body></html>