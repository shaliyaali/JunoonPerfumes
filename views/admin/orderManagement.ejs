<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Order Management - Junoon Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: { primary: "#D4AF37", "background-light": "#FAFAFA", "background-dark": "#0F0F0F", "sidebar-light": "#FDFBF7", "sidebar-dark": "#1A1A1A", "card-light": "#FFFFFF", "card-dark": "#242424" },
                    fontFamily: { display: ["Playfair Display", "serif"], sans: ["Inter", "sans-serif"] },
                },
            },
        };
    </script>
</head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 transition-colors duration-200">
<div class="flex min-h-screen max-w-[1550px] mx-auto shadow-2xl">
    <!-- Sidebar (Reusing your existing structure) -->
    <aside class="w-64 bg-sidebar-light dark:bg-sidebar-dark border-r border-stone-200 dark:border-stone-800 flex flex-col sticky top-0 h-screen transition-colors duration-300">
        <div class="p-8">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-primary flex items-center justify-center rounded-lg text-white">
                    <span class="material-symbols-outlined">spa</span>
                </div>
                <div>
                    <h1 class="font-display text-xl font-bold text-stone-900 dark:text-white leading-none">Junoon</h1>
                    <p class="text-[10px] uppercase tracking-widest text-primary font-bold mt-1">Admin Suite</p>
                </div>
            </div>
        </div>
        <!-- <nav class="flex-1 px-4 mt-4 space-y-1">
            <a class="flex items-center gap-3 px-4 py-3 text-stone-500 dark:text-stone-400 hover:bg-stone-100 rounded-xl transition-all" href="/admin/dashboard">
                <span class="material-symbols-outlined">dashboard</span>
                <span class="font-medium">Dashboard</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 bg-primary text-white rounded-xl shadow-lg shadow-primary/20 transition-all" href="#">
                <span class="material-symbols-outlined">shopping_cart</span>
                <span class="font-medium">Orders</span>
            </a>
             Other links... 
        </nav> -->

        <nav class="space-y-1">
<a class="flex items-center px-4 py-3 text-slate-500 dark:text-slate-400 hover:text-primary transition-colors group" href="/admin/dashboard">
<span class="material-symbols-outlined mr-3 text-xl group-hover:scale-110 transition-transform">dashboard</span>
<span class="text-sm font-medium">Dashboard</span>
</a>
<a class="flex items-center px-4 py-3 text-slate-500 dark:text-slate-400 hover:text-primary transition-colors group" href="/admin/productManagement">
<span class="material-symbols-outlined mr-3 text-xl group-hover:scale-110 transition-transform">inventory_2</span>
<span class="text-sm font-medium">Products</span>
</a>
<a class="flex items-center px-4 py-3 bg-primary text-white rounded-lg shadow-lg shadow-primary/20" href="/admin/orders">
<span class="material-symbols-outlined mr-3 text-xl">shopping_cart</span>
<span class="text-sm font-semibold">Orders</span>
</a>
<a class="flex items-center px-4 py-3 text-slate-500 dark:text-slate-400 hover:text-primary transition-colors group" href="/admin/categoryManagement">
<span class="material-symbols-outlined mr-3 text-xl group-hover:scale-110 transition-transform">category</span>
<span class="text-sm font-medium">Categories </span>
</a>
<a class="flex items-center px-4 py-3 text-slate-500 dark:text-slate-400 hover:text-primary transition-colors group" href="/admin/usermanagement">
<span class="material-symbols-outlined mr-3 text-xl group-hover:scale-110 transition-transform">people</span>
<span class="text-sm font-medium">Users</span>
</a>
<a class="flex items-center px-4 py-3 text-slate-500 dark:text-slate-400 hover:text-primary transition-colors group" href="#">
<span class="material-symbols-outlined mr-3 text-xl group-hover:scale-110 transition-transform">local_offer</span>
<span class="text-sm font-medium">Coupons</span>
</a>
<a class="flex items-center px-4 py-3 text-slate-500 dark:text-slate-400 hover:text-primary transition-colors group" href="#">
<span class="material-symbols-outlined mr-3 text-xl group-hover:scale-110 transition-transform">bar_chart</span>
<span class="text-sm font-medium">Sales &amp; Revenue</span>
</a>
</nav>
    </aside>

    <main class="flex-1 flex flex-col">
        <header class="h-24 px-10 flex items-center justify-between border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-sidebar-dark">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Order Management</h2>
            <button class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 transition-colors" onclick="document.documentElement.classList.toggle('dark')">
                <span class="material-symbols-outlined dark:hidden">dark_mode</span>
                <span class="material-symbols-outlined hidden dark:block">light_mode</span>
            </button>
        </header>

        <div class="p-10 space-y-8 flex-1">
            <!-- Filters -->
            <form action="/admin/orders" method="GET" class="flex flex-wrap gap-4 bg-white dark:bg-card-dark p-6 rounded-2xl border border-slate-200 dark:border-slate-800">
                <div class="flex-1 min-w-[300px] relative">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">search</span>
                    <input type="text" name="search" value="<%= search %>" class="w-full pl-12 pr-4 py-3 bg-slate-50 dark:bg-background-dark border-none rounded-xl focus:ring-2 focus:ring-primary outline-none" placeholder="Search by Order ID or Customer Name...">
                </div>
                <select name="status" onchange="this.form.submit()" class="w-48 py-3 bg-slate-50 dark:bg-background-dark border-none rounded-xl focus:ring-2 focus:ring-primary outline-none">
                    <option value="all" <%= status === 'all' ? 'selected' : '' %>>All Status</option>
                    <% ['Pending', 'Shipped', 'Out for Delivery', 'Partially Delivered','Delivered', 'Cancelled'].forEach(s => { %>
                        <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
                    <% }) %>
                </select>
                <a href="/admin/orders" class="px-6 py-3 text-slate-400 hover:text-primary transition-colors flex items-center">Clear</a>
            </form>

            <!-- Table -->
            <div class="bg-white dark:bg-card-dark rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
                <table class="w-full text-left">
                    <thead class="bg-slate-50 dark:bg-slate-800/50 text-xs uppercase font-bold text-slate-500 tracking-widest">
                        <tr>
                            <th class="px-8 py-5">Order ID</th>
                            <th class="px-8 py-5">Date</th>
                            <th class="px-8 py-5">Customer</th>
                            <th class="px-8 py-5">Total</th>
                            <th class="px-8 py-5">Status</th>
                            <th class="px-8 py-5 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        <% orders.forEach(order => { %>
                            <tr class="hover:bg-slate-50/50 dark:hover:bg-white/[0.02] transition-colors">
                                <td class="px-8 py-5 font-bold text-primary text-sm"><%= order.orderId %></td>
                                <td class="px-8 py-5 text-sm text-slate-500"><%= new Date(order.orderDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                                <td class="px-8 py-5">
                                    <div class="text-sm font-semibold"><%= order.user.name %></div>
                                    <div class="text-[10px] text-slate-400 uppercase tracking-tight"><%= order.user.email %></div>
                                </td>
                                <td class="px-8 py-5 font-bold">₹<%= order.totalAmount.toLocaleString() %></td>
                                <td class="px-8 py-5">
                                    <select onchange="updateStatus('<%= order.orderId %>', this.value)" 
                                            class="text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full border-none focus:ring-1 focus:ring-primary
                                            <%= order.status === 'Delivered' ? 'bg-green-100 text-green-700' : 
                                               order.status === 'Cancelled' ? 'bg-rose-100 text-rose-700' : 
                                               order.status === 'Partially Delivered' ? 'bg-indigo-100 text-indigo-700' : 'bg-amber-100 text-amber-700' %>">
                                        <% ['Pending', 'Shipped', 'Out for Delivery', 'Partially Delivered', 'Delivered', 'Cancelled'].forEach(s => { %>
                                            <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %> <%= (order.status === 'Delivered' || order.status === 'Cancelled') ? 'disabled' : '' %>><%= s %></option>
                                        <% }) %>
                                    </select>
                                </td>
                                <td class="px-8 py-5 text-right space-x-3">
                                    <a href="/admin/orders/<%= order.orderId %>" class="text-xs font-bold text-slate-400 hover:text-primary transition-colors uppercase tracking-widest">Details</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
                
                <!-- Pagination -->
                <div class="p-6 border-t border-slate-100 dark:border-slate-800 flex justify-center gap-2">
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <a href="?page=<%= i %>&search=<%= search %>&status=<%= status %>" 
                           class="w-10 h-10 flex items-center justify-center rounded-lg font-bold text-xs transition-all 
                           <%= currentPage == i ? 'bg-primary text-white shadow-lg' : 'text-slate-400 hover:bg-slate-100' %>">
                            <%= i %>
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    async function updateStatus(orderId, newStatus) {
        const result = await Swal.fire({
            title: 'Update Status?',
            text: `Change order status to ${newStatus}?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#D4AF37'
        });

        if (result.isConfirmed) {
            try {
                const response = await fetch('/admin/orders/update-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderId, status: newStatus })
                });
                const data = await response.json();
                if (data.success) location.reload();
            } catch (err) {
                Swal.fire('Error', 'Failed to update status', 'error');
            }
        }
    }
</script>
</body>
</html>
